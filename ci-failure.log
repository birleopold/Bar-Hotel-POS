m.\n   They never record a payment without the cashier\'s normal form submission. */\ndocument.addEventListener("click", function(event) {\n  var button = event.target.closest("[data-fizo-payment-method]");\n  if (!button) return;\n  var form = document.querySelector("[data-pos-payment-form]");\n  var method = form && form.querySelector(\'select[name="method"]\');\n  var amount = form && form.querySelector(\'input[name="amount"]\');\n  if (!method) return;\n  var choice = button.getAttribute("data-fizo-payment-method");\n  if (!Array.from(method.options).some(function(opt) { return opt.value === choice; })) return;\n  method.value = choice;\n  method.dispatchEvent(new Event("change", {bubbles:true}));\n  document.querySelectorAll("[data-fizo-payment-method]").forEach(function(candidate) {\n    candidate.setAttribute("aria-pressed", candidate === button ? "true" : "false");\n  });\n  if (amount) { amount.focus(); amount.select(); }\n});\n\n/* Quantity steppers submit the existing authenticated stock-adjustment form. */\ndocument.addEventListener("click", function (event) {\n  var button = event.target.closest("[data-fizo-step]");\n  if (!button) return;\n  var form = button.closest("[data-fizo-qty-form]");\n  if (!form || form.dataset.submitting === "1") return;\n  var input = form.querySelector(\'input[name="quantity"]\');\n  if (!input) return;\n  var current = Number(input.value), delta = Number(button.dataset.fizoStep);\n  if (!Number.isFinite(current) || !Number.isFinite(delta)) return;\n  var next = Math.round((current + delta) * 1000) / 1000;\n  if (next < 0.001) return;\n  input.value = String(next);\n  form.dataset.submitting = "1";\n  if (form.requestSubmit) form.requestSubmit(); else form.submit();\n});\n\n/* Retail-only composition; existing POST forms still own all stock and payment rules. */\n(function () {\n  function initializeRetailWorkspace() {\n    var catalogue = document.querySelector(".fizo-checkout-catalogue");\n    var basket = document.queryS