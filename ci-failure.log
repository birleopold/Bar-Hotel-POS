ff-btn staff-btn--ghost" target="_blank" rel="noopener" href="{% url \'staff-retail-customer-display\' order_id=order.id %}">Open customer display on second screen</a>\n    <p class="staff-muted small mb-0">Read-only, staff-session protected. Move this tab to the second monitor; public access is disabled.</p></div>\n  {% if can_modify_open_order and scan_add_form %}\n    <div class="staff-card" id="retail-fast-checkout" aria-label="Fast supermarket checkout">\n      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">\n        <div><h2 class="staff-card__title mb-1">Scan items</h2><p class="staff-muted small mb-0">Scan a barcode or enter a product code. Press Enter to add it. Set quantity only when selling multiple items or measured goods.</p></div>\n        <span class="staff-tag">Scan or enter PLU</span>\n      </div>\n      <form method="post" class="row g-3 align-items-end" data-retail-scan-form>\n        {% csrf_token %}\n        <input type="hidden" name="action" value="scan_add_line">\n        <div class="col-md-6">{{ scan_add_form.code.label_tag }}{{ scan_add_form.code }}</div>\n        <div class="col-md-3">{{ scan_add_form.quantity.label_tag }}{{ scan_add_form.quantity }}</div>\n        <div class="col-md-3"><button type="submit" class="staff-btn staff-btn--primary staff-btn--touch" data-retail-scan-submit>Add item</button></div>\n      </form>\n      <p class="staff-muted small mt-2 mb-0" role="status" data-retail-scan-status aria-live="polite">Scanner ready. Each successful scan updates the basket using the existing stock and pricing rules.</p>\n    </div>\n  {% endif %}\n  {% if order.status == \'closed\' and order.is_paid %}\n    <div class="staff-card">\n      <h2 class="staff-card__title">Sale completed</h2>\n      <p class="staff-muted">Print the receipt using the links above. Start a new basket when the next customer is ready.</p>\n      <form method="post" action="{% url \'staff-order-quick-create\' %}">{% csrf_token %}<button class="staff-btn staff-btn--primary staff-btn--touch" type="submit">Next customer · new sale</button></form>\n    </div>\n  {% endif %}\n  {% if can_record_payment and payment_form %}\n    <section class="staff-card" aria-label="Cash tender calculator" data-retail-cash-panel data-balance-due="{{ balance_due }}">\n      <h2 class="staff-card__title">Cash payment · calculate change</h2>\n      <p class="staff-muted small">Enter what the shopper hands you to see their change. To complete payment, use <strong>Pay</strong> and select <strong>Cash</strong>. The cash-received figure is not the sale amount.</p>\n      <div class="row g-2 align-items-end">\n        <div class="col-12 col-sm-6"><label class="staff-label" for="retail-cash-received">Cash received ({{ order.currency }})</label><input id="retail-cash-received" class="staff-input" type="number" min="0" step="0.01" inputmode="decimal" data-retail-cash-received></div>\n        <div class="col-12 col-sm-6"><span class="staff-label">Change to return</span><output class="d-block fw-bold" for="retail-cash-received" data-retail-change>—</output></div>\n      </div>\n      <p class="staff-muted small mt-2 mb-0" role="status" aria-live="polite" data-retail-tender-status>Enter the cash handed over to calculate change.</p>\n    </section>\n  {% endif %}\n  {% if order.is_paid and order.status == \'closed\' %}\n  <section class="staff-card mb-3" aria-label="Paid order pickup">\n    <h2 class="staff-card__title">Paid sale · collection or pickup</h2>\n    <p class="staff-muted small">A confirmed pickup records the handover of goods already sold. It does not reserve unpaid stock, issue a deposit refund or change inventory twice.</p>\n    {% if retail_pickup %}\n      <p><strong>{{ retail_pickup.get_status_display }}</strong> · Expected {{ retail_pickup.expected_on }}\n      {% if retail_pickup.collected_at %} · Collected {{ retail_pickup.collected_at }} by {{ retail_pickup.collected_by.email|default:"Former worker" }}{% endif %}</p>\n      {% if retail_pickup.status == \'awaiting\' and can_modify_open_order == False %}\n      <form method="post" class="row g-2">{% csrf_token %}\n        <input type="hidden" name="action" value="hand_over_paid_pickup">\n        <div class="col-12 col-lg-9"><label class="staff-label" for="pickup-proof">Customer identity and physical handover confirmation</label>\n          <textarea class="staff-input" id="pickup-proof" name="note" required minlength="12" maxlength="300" rows="2"></textarea></div>\n        <div class="col-12 col-lg-3 align-self-end"><button class="staff-btn staff-btn--primary" type="submit">Confirm collected</button></div></form>{% endif %}\n    {% elif can_schedule_paid_pickup %}\n      <form method="post" class="row g-2 align-items-end">{% csrf_token %}\n        <input type="hidden" name="action" value="schedule_paid_pickup">\n        <div class="col-12 col-md-4"><label class="staff-label" for="pickup-when">Expected collection date</label>\n          <input class="staff-input" type="date" id="pickup-when" name="expected_on" required></div>\n        <div class="col-12 col-md-5"><label class="staff-label" for="pickup-note">Collection note</label>\n          <input class="staff-input" id="pickup-note" name="note" maxlength="300" placeholder="Collection shelf or pickup instructions"></div>\n        <div class="col-12 col-md-3"><button type="submit" class="staff-btn staff-btn--primary">Schedule pickup</button></div></form>\n    {% else %}<p class="staff-muted">An identified customer and manager approval are required to schedule collection.</p>{% endif %}\n    <a class="staff-btn staff-btn--ghost mt-2" href="{% url \'staff-retail-pickups\' %}">See pickup queue</a>\n  </section>{% endif %}\n  <section class="staff-card mb-3" aria-label="Wholesale prices">\n    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">\n      <div><h2 class="staff-card__title">Wholesale quantity pricing</h2>\n      <p class="staff-muted small">Only for identified customers and authorized managers. Regular walk-in shoppers keep shelf prices. Never combined with an order promotion.</p></div>\n      <a class="staff-btn staff-btn--ghost" href="{% url \'staff-wholesale-pricing\' %}">Manage tiers</a>\n    </div>\n    {% if can_apply_wholesale %}\n    <form method="post" class="row g-2 align-items-end">{% csrf_token %}\n      <input type="hidden" name="action" value="apply_wholesale">\n      <div class="col-12 col-md-8"><label class="staff-label" for="wholesale-line">Eligible order item</label>\n      <select name="line_id" id="wholesale-line" class="staff-input" required>\n        <option value="">Select eligible line</option>\n        {% for line, rule in wholesale_available_lines %}{% if rule %}\n        <option value="{{ line.id }}">{{ line.label }} · {{ line.quantity }} units · {{ order.currency }} {{ rule.unit_price }} per unit (from {{ rule.minimum_quantity }})</option>\n        {% endif %}{% endfor %}\n      </select></div>\n      <div class="col-12 col-md-4"><button type="submit" class="staff-btn staff-btn--primary staff-btn--touch">Manager: apply wholesale price</button></div>\n    </form>\n    {% else %}<p class="staff-muted">Link the customer\'s verified profile before recording payment to enable wholesale approval. Manager rights required.</p>{% endif %}\n  </section>\n  {% if can_modify_open_order and line_discount_form %}\n    <div class="staff-card">\n      <h2 class="staff-card__title">Line discount</h2>\n      <p class="staff-muted">Choose the item to discount, then enter an amount or percent.</p>\n      {% include "staff/includes/form_errors_block.html" with form=line_discount_form title="Fix discount details" %}\n      <form method="post" class="row g-2 align-items-end">\n        {% csrf_token %}\n        <input type="hidden" name="action" value="line_discount">\n        <div class="col-md-3">\n          <label class="staff-label" for="disc_line">Order item</label>\n          <select class="staff-input" id="disc_line" name="line_id" required>\n            <option value="">Select an item</option>\n            {% for line in order.lines.all %}{% if not line.is_voided %}<option value="{{ line.id }}">{{ line.label }} · {{ line.quantity }}</option>{% endif %}{% endfor %}\n          </select>\n        </div>\n        <div class="col-md-3">{{ line_discount_form.discount_amount.label_tag }}{{ line_discount_form.discount_amount }}</div>\n        <div class="col-md-3">{{ line_discount_form.discount_percent.label_tag }}{{ line_discount_form.discount_percent }}</div>\n        <div class="col-md-3"><button type="submit" class="staff-btn staff-btn--ghost">Apply</button></div>\n      </form>\n    </div>\n  {% endif %}\n  {% if retail_refund_form %}\n    <div class="staff-card">\n      <h2 class="staff-card__title">Return and refund</h2>\n      <p class="staff-muted small">Refund till: {% if settlement_station %}<strong>{{ settlement_station.name }}</strong>{% else %}automatic when one shift is open{% endif %} · <a href="{% url \'staff-workstations\' %}">Choose till</a></p>\n      <p class="staff-muted">Record the returned quantity and the customer refund together. Enter the actual amount to return, including any discount or tax adjustment. Choose the original payment when the order has split tenders. Restock only goods physically received and suitable for resale.</p>\n      <form method="post" class="row g-3 align-items-end">\n        {% csrf_token %}\n        <input type="hidden" name="action" value="retail_line_refund">\n        {% for field in retail_refund_form %}\n          <div class="col-6 col-lg-3">{{ field.label_tag }}{{ field }}{{ field.errors }}</div>\n        {% endfor %}\n        <div class="col-12"><button type="submit" class="staff-btn staff-btn--primary staff-btn--touch">Record return and refund</button></div>\n      </form>\n    </div>\n  {% endif %}\n  {% if line_return_form %}\n    <div class="staff-card">\n      <h2 class="staff-card__title">Physical return only</h2>\n      {% include "staff/includes/form_errors_block.html" with form=line_return_form title="Fix return details" %}\n      <form method="post" class="row g-2 align-items-end">\n        {% csrf_token %}\n        <input type="hidden" name="action" value="line_return">\n        <p class="staff-muted col-12">Use this for an exchange or an item received without a customer refund. For a refund, use “Return and refund” above. Select restock only for direct-sale goods actually back on hand; prepared recipe ingredients are not recovered automatically.</p>\n        <div class="col-md-3">\n          <label class="staff-label" for="ret_line">Order item</label>\n          <select class="staff-input" id="ret_line" name="line_id" required>\n            <option value="">Select an item</option>\n            {% for line in order.lines.all %}{% if not line.is_voided %}<option value="{{ line.id }}">{{ line.label }} · {{ line.quantity }}</option>{% endif %}{% endfor %}\n          </select>\n        </div>\n        <div class="col-md-2">{{ line_return_form.quantity.label_tag }}{{ line_return_form.quantity }}</div>\n        <div class="col-md-4">{{ line_return_form.reason.label_tag }}{{ line_return_form.reason }}</div>\n        <div class="col-md-2"><label class="staff-label" for="{{ line_return_form.restock.id_for_label }}">{{ line_return_form.restock }} Restock received goods</label></div>\n        <div class="col-md-1"><button type="submit" class="staff-btn staff-btn--primary">Return</button></div>\n      </form>\n    </div>\n  {% endif %}\n  {% if order.supermarket_returns.all %}\n    <div class="staff-card">\n      <h2 class="staff-card__title">Return history</h2>\n      <div class="staff-table-wrap"><table class="staff-table">\n        <caption class="visually-hidden">Physical returns recorded for this order</caption>\n        <thead><tr><th>Item</th><th>Qty</th><th>Stock</th><th>Customer refund</th><th>Refund till</th><th>Reason</th></tr></thead>\n        <tbody>{% for ret in order.supermarket_returns.all %}<tr><td>{{ ret.order_line.label }}</td><td>{{ ret.quantity }}</td><td>{% if ret.restocked %}Restocked{% else %}Not restocked{% endif %}</td><td>{% if ret.refund %}{{ ret.refund.amount }} · {{ ret.refund.payment.get_method_display }}{% else %}None{% endif %}</td><td>{{ ret.refund.shift.workstation.name|default:"Section / unassigned" }}</td><td>{{ ret.reason|default:"—" }}</td></tr>{% endfor %}</tbody>\n      </table></div>\n    </div>\n  {% endif %}\n{% endblock %}\n\n{% block extra_js %}\n<script>\n(function(){\n  function start(){\n    var catalog=document.querySelector(\'.fizo-checkout-catalogue\');\n    var basket=document.querySelector(\'.fizo-checkout-basket\');\n    var search=document.querySelector(\'[data-pos-menu-search]\');\n    var scan=document.querySelector(\'[data-retail-scan-form] input[name="code"]\');\n    if(basket) basket.id=\'fizo-current-basket\';\n    if(search){ search.id=\'fizo-pos-menu-search\'; search.setAttribute(\'aria-label\',\'Find product by name, barcode or SKU\'); }\n    function activate(selector,input){\n      var link=document.querySelector(selector);\n      if(!link)return;\n      link.addEventListener(\'click\',function(e){\n        if(!input)return;\n        e.preventDefault();input.focus();input.select();\n        if(catalog && input===search)catalog.scrollIntoView({behavior:\'smooth\',block:\'start\'});\n      });\n    }\n    activate(\'[data-fizo-focus-search]\',search);\n    activate(\'[data-fizo-focus-scan]\',scan);\n    document.addEventListener(\'keydown\',function(e){\n      if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()===\'k\'&&search){e.preventDefault();search.focus();search.select();}\n    });\n  }\n  if(document.readyState===\'loading\')document.addEventListener(\'DOMContentLoaded\',start);else start();\n})();\n</script>\n\n{{ block.super }}\n<script src="{% static \'staff/grocery-checkout.js\' %}?v=20261022.2" defer></script>\n<script>\n/* Manual selection never submits a sale. Only the explicit Add button does.\n   Barcode submission continues through the dedicated scanner form. */\n</script>\n\n<script>\n(function () {\n  "use strict";\n  var form = document.querySelector("[data-retail-scan-form]");\n  if (form) {\n    var input = form.querySelector(\'input[name="code"]\');\n    var quantity = form.querySelector(\'input[name="quantity"]\');\n    var button = form.querySelector("[data-retail-scan-submit]");\n    var status = document.querySelector("[data-retail-scan-status]");\n    if (input && button) {\n      input.setAttribute("aria-label", "Barcode or product lookup code");\n      input.setAttribute("enterkeyhint", "done");\n      // Header search owns initial focus on desktop; never focus a hidden scanner.\n      document.addEventListener("keydown", function (event) {\n        if (event.key !== "/" || event.ctrlKey || event.altKey || event.metaKey || event.repeat) return;\n        var target = event.target;\n        if (target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;\n        event.preventDefault();\n        var top = document.getElementById("reference-top-catalogue-search");\n        if(top){top.focus();top.select();}else{input.focus();input.select();}\n      });\n      var submitted = false;\n      form.addEventListener("submit", function (event) {\n        if (submitted) { event.preventDefault(); return; }\n        if (!input.value.trim()) {\n          event.preventDefault();\n          input.focus();\n          if (status) status.textContent = "Scan a barcode or type a PLU first.";\n          return;\n        }\n        var qty = quantity ? Number(quantity.value) : 1;\n        if (!Number.isFinite(qty) || qty <= 0 || Math.round(qty * 1000) !== qty * 1000) {\n          event.preventDefault();\n          if (quantity) quantity.focus();\n          if (status) status.textContent = "Enter a positive quantity with at most three decimal places.";\n          return;\n        }\n        submitted = true;\n        button.disabled = true;\n        if (status) status.textContent = "Adding item to basket…";\n      });\n    }\n  }\n  var paymentSubmitForm = document.querySelector("[data-pos-payment-form]");\n  if (paymentSubmitForm) {\n    var paymentPending = false;\n    paymentSubmitForm.addEventListener("submit", function (event) {\n      if (paymentPending) { event.preventDefault(); return; }\n      if (!paymentSubmitForm.checkValidity()) return;\n      paymentPending = true;\n      var submitButton = paymentSubmitForm.querySelector(\'button[type="submit"]\');\n      if (submitButton) {\n        submitButton.disabled = true;\n        submitButton.textContent = "Recording payment…";\n      }\n    });\n  }\n  var cashPanel = document.querySelector("[data-retail-cash-panel]");\n  if (cashPanel) {\n    var received = cashPanel.querySelector("[data-retail-cash-received]");\n    var change = cashPanel.querySelector("[data-retail-change]");\n    var tenderStatus = cashPanel.querySelector("[data-retail-tender-status]");\n    var paymentAction = document.querySelector(\'form input[name="action"][value="record_payment"]\');\n    var paymentForm = paymentAction && paymentAction.form;\n    var paymentAmount = paymentForm && paymentForm.querySelector(\'input[name="amount"]\');\n    var paymentMethod = paymentForm && paymentForm.querySelector(\'select[name="method"]\');\n    var dueRaw = Number(cashPanel.getAttribute("data-balance-due"));\n    var dueCents = Math.round(dueRaw * 100);\n    function calculateChange() {\n      var raw = received.value.trim();\n      var tender = raw === "" ? NaN : Number(raw);\n      var cents = Math.round(tender * 100);\n      change.textContent = "—";\n      if (!Number.isFinite(dueRaw) || !Number.isFinite(tender) || tender < 0 ||\n          !Number.isSafeInteger(cents) || Math.abs(tender * 100 - cents) > 0.000001) {\n        tenderStatus.textContent = "Enter a valid cash amount with at most two decimal places.";\n        return;\n      }\n      if (cents < dueCents) {\n        tenderStatus.textContent = "Cash is less than the amount due. Use the payment form for a partial payment.";\n        return;\n      }\n      change.textContent = ((cents - dueCents) / 100).toFixed(2);\n      tenderStatus.textContent = "Change shown above. Record the due amount, not the cash tendered.";\n      if (paymentAmount && paymentMethod && paymentMethod.value === "cash") {\n        paymentAmount.value = (dueCents / 100).toFixed(2);\n      }\n    }\n    received.addEventListener("input", calculateChange);\n    if (paymentMethod) paymentMethod.addEventListener("change", calculateChange);\n  }\n})();\n</script>\n\n<script>\n/* Shortcuts only select an allowed method and focus the existing payment form.\n   They never record a payment without the cashier\'s normal form submission. */\ndocument.addEventListener("click", function(event) {\n  var button = event.target.closest("[data-fizo-payment-method]");\n  if (!button) return;\n  var form = document.querySelector("[data-pos-payment-form]");\n  var method = form && form.querySelector(\'select[name="method"]\');\n  var amount = form && form.querySelector(\'input[name="amount"]\');\n  if (!method) return;\n  var choice = button.getAttribute("data-fizo-payment-method");\n  if (!Array.from(method.options).some(function(opt) { return opt.value === choice; })) return;\n  method.value = choice;\n  method.dispatchEvent(new Event("change", {bubbles:true}));\n  document.querySelectorAll("[data-fizo-payment-method]").forEach(function(candidate) {\n    candidate.setAttribute("aria-pressed", candidate === button ? "true" : "false");\n  });\n  if (amount) { amount.focus(); amount.select(); }\n});\n\n/* Quantity steppers submit the existing authenticated stock-adjustment form. */\ndocument.addEventListener("click", function (event) {\n  var button = event.target.closest("[data-fizo-step]");\n  if (!button) return;\n  var form = button.closest("[data-fizo-qty-form]");\n  if (!form || form.dataset.submitting === "1") return;\n  var input = form.querySelector(\'input[name="quantity"]\');\n  if (!input) return;\n  var current = Number(input.value), delta = Number(button.dataset.fizoStep);\n  if (!Number.isFinite(current) || !Number.isFinite(delta)) return;\n  var next = Math.round((current + delta) * 1000) / 1000;\n  if (next < 0.001) return;\n  input.value = String(next);\n  form.dataset.submitting = "1";\n  if (form.requestSubmit) form.requestSubmit(); else form.submit();\n});\n\n/* Retail-only composition; existing POST forms still own all stock and payment rules. */\n(function () {\n  function initializeRetailWorkspace() {\n    var catalogue = document.querySelector(".fizo-checkout-catalogue");\n    var basket = document.querySelector(".fizo-checkout-basket");\n    var scanner = document.querySelector("#retail-fast-checkout");\n    if (!catalogue || !basket) return;\n    // Brand and search already live in the actual cashier header; no duplicate heading.\n    if (scanner) {\n      catalogue.insertBefore(scanner, catalogue.firstChild);\n      scanner.classList.add("fizo-retail-pos-scanner");\n      scanner.querySelectorAll("input").forEach(function (input) {\n        if (input.type === "text" || input.type === "search") {\n          input.setAttribute("placeholder", "Scan barcode or enter product code");\n          input.setAttribute("autocomplete", "off");\n        }\n      });\n    }\n    var quickForm = document.querySelector("#fizo-quick-product");\n    if (quickForm) {\n      if (scanner) scanner.insertAdjacentElement("afterend", quickForm);\n      else catalogue.insertBefore(quickForm, catalogue.firstChild);\n      var quickSubmit = quickForm.querySelector(\'form[data-fizo-quick-product-form]\');\n      if (quickSubmit) quickSubmit.addEventListener("submit", function (event) {\n        if (quickSubmit.dataset.submitted === "1") { event.preventDefault(); return; }\n        if (!quickSubmit.checkValidity()) return;\n        quickSubmit.dataset.submitted = "1";\n        var button = quickSubmit.querySelector(\'button[type="submit"]\');\n        if (button) { button.disabled = true; button.textContent = "Adding product…"; }\n      });\n    }\n    // F3 is handled by retail-counter-v2.js through the visible header.\n    var cards = catalogue.querySelectorAll("[data-pos-menu-tile]");\n    cards.forEach(function (tile) {\n      tile.setAttribute("title", "Select " + (tile.dataset.itemName || "product") + " and add to basket");\n    });\n  }\n  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initializeRetailWorkspace);\n  else initializeRetailWorkspace();\n})();\n</script>\n{% endblock %}\n'
