on () {\n  "use strict";\n  var pad=document.querySelector("[data-fizo-pin-pad]");\n  var pin=document.querySelector(\'input[name="pin"]\');\n  if (!pad||!pin) return;\n  pad.addEventListener("click",function(event){\n    var key=event.target.closest("button[data-key]");\n    if(!key)return;\n    var value=key.getAttribute("data-key");\n    if(value==="clear")pin.value="";\n    else if(value==="delete")pin.value=pin.value.slice(0,-1);\n    else if(/^\\d$/.test(value) && pin.value.length<8)pin.value+=value;\n    pin.dispatchEvent(new Event("input",{bubbles:true}));\n  });\n})();\n</script>\n</body></html>'
