n          <div class="staff-pos-order-card__pricing">\n            <div class="staff-pos-order-card__total">{{ o.currency }} {{ o.total }}</div>\n            <div class="staff-pos-order-card__due">Paid {{ o.display_paid }} · Due {{ o.display_balance }}</div>\n          </div>\n          <div class="staff-pos-order-card__chevron">\n            <i class="bi bi-chevron-right"></i>\n          </div>\n        </a>\n      {% empty %}\n        {% url "staff-orders" as orders_url %}\n        {% if show_supermarket_lane %}{% include "staff/includes/empty_state.html" with title="No sales match your filters" message="Try changing the search or status, or start a new checkout." action_url=orders_url action_label="Reset filters" %}{% else %}{% include "staff/includes/empty_state.html" with title="No orders match your filters" message="Try clearing the status/search filters or create a new order tab." action_url=orders_url action_label="Reset filters" %}{% endif %}\n      {% endfor %}\n      </div>\n\n    {% if is_paginated %}\n      <nav class="staff-pager staff-pager--pos staff-pager--pos-footer" aria-label="{% if show_supermarket_lane %}Past sales pages{% else %}Past orders pages{% endif %}">\n        {% if page_obj.has_previous %}\n          <a class="staff-btn staff-btn--sm staff-btn--ghost" rel="prev" href="?page={{ page_obj.previous_page_number }}{% if status_filter %}&status={{ status_filter }}{% endif %}{% if returns_task %}&task=returns{% endif %}{% if mine_filter %}&mine=1{% endif %}{% if q_filter %}&q={{ q_filter|urlencode }}{% endif %}"><i class="bi bi-chevron-left me-1"></i>Newer</a>\n        {% else %}\n          <span class="staff-pager__spacer"></span>\n        {% endif %}\n        <span class="staff-pager__meta">Page {{ page_obj.number }} of {{ paginator.num_pages }}</span>\n        {% if page_obj.has_next %}\n          <a class="staff-btn staff-btn--sm staff-btn--ghost" rel="next" href="?page={{ page_obj.next_page_number }}{% if status_filter %}&status={{ stat