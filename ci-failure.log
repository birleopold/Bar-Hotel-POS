lass="staff-kds-summary__metric staff-kds-summary__metric--working"><span>In preparation</span><strong>{{ kds_summary.in_prep }}</strong></div>\n        <div class="staff-kds-summary__metric staff-kds-summary__metric--ready"><span>Ready for service</span><strong>{{ kds_summary.ready }}</strong></div>\n        <div class="staff-kds-summary__metric"><span>Overdue</span><strong>{{ kds_summary.overdue }}</strong></div>\n        <div class="staff-kds-summary__metric"><span>Rush</span><strong>{{ kds_summary.rush }}</strong></div>\n      </section>\n      <div id="staff-kds-queue-region" class="staff-kds-queue-region">\n      {% if not kds_orders %}\n        <div class="staff-kds-empty"><span class="staff-kds-empty__icon" aria-hidden="true"><i class="bi bi-check2-circle"></i></span><h2>All caught up</h2><p>No prep lines are waiting at this section.</p></div>\n      {% endif %}\n      <div class="staff-pos-kds-scroll staff-pos-grow">\n        <div class="staff-pos-kds-grid">\n        {% for pack in kds_orders %}\n          <article class="staff-card staff-card--pos staff-pos-kds-card mb-0{% if pack.is_rush %} kds-ticket--rush{% endif %}" data-kds-ticket-id="{{ pack.order.id }}">\n            <header class="staff-pos-kds-card__head">\n              <div><span class="staff-pos-kds-card__eyebrow">Ticket</span><h2 class="staff-pos-kds-card__title"><a class="staff-pos-kds-card__link" href="{% url \'staff-order-detail\' order_id=pack.order.id %}">{{ pack.order.bill_reference }}</a></h2></div>\n              {% if pack.is_rush %}<span class="kds-rush-tag">Rush order</span>{% endif %}\n              <span class="kds-age-summary">Oldest: {{ pack.oldest_minutes }} min</span>\n              {% if pack.order.table_label %}<span class="staff-pos-kds-card__table"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> {{ pack.order.table_label }}</span>{% endif %}\n            </header>\n            <div class="staff-pos-kds-lines">\n              {% for row in pack.lines %}\n                {% with ln=row.line %}\n                  <div class="staff-pos-kds-line{% if ln.kds_status == \'ready\' %} staff-pos-kds-line--ready{% elif ln.kds_status == \'in_prep\' %} staff-pos-kds-line--working{% endif %}{% if row.overdue %} kds-line--overdue{% endif %}{% if ln.kds_rush %} kds-line--rush{% endif %}" data-kds-created-at="{{ ln.created_at|date:\'c\' }}">\n                    <div class="staff-pos-kds-line__main">\n                      <div class="staff-pos-kds-line__qty">{{ ln.quantity }}×</div>\n                      <div class="staff-pos-kds-line__name">\n                        {{ ln.label }}\n                        {% if ln.kds_rush %}<strong class="kds-rush-tag">Rush</strong>{% endif %}\n                        <span class="kds-line-timer"{% if row.overdue %} data-kds-overdue="true"{% endif %} data-kds-age-seconds="{{ row.minutes_waiting|default:0 }}">{{ row.minutes_waiting }} min waiting{% if row.overdue %} · Overdue{% endif %}</span>\n                        {% if ln.modifiers_snapshot %}<ul class="kds-modifier-list">{% for modifier in ln.modifiers_snapshot %}<li>{{ modifier.name|default:"Option" }}</li>{% endfor %}</ul>{% endif %}\n                        <div class="staff-pos-kds-line__details"><span class="staff-pos-kds-status staff-pos-kds-status--{{ ln.kds_status }}">{{ ln.get_kds_status_display }}</span>{% if ln.kds_station %}<span class="staff-pos-kds-line__station"><i class="bi bi-geo-alt" aria-hidden="true"></i> {{ ln.kds_station }}</span>{% endif %}</div>\n                      </div>\n                    </div>\n                    <div class="staff-pos-kds-line__action">\n                      {% if can_modify_kds and ln.kds_status == \'pending\' %}\n                        <form method="post" class="m-0">{% csrf_token %}\n                          <input type="hidden" name="order_id" value="{{ pack.order.id }}">\n                          <input type="hidden" name="line_id" value="{{ ln.id }}">\n                          <input type="hidden" name="kds_status" value="accepted">\n                          {% if station_filter %}<input type="hidden" name="station" value="{{ station_filter }}">{% endif %}\n                          <button type="submit" class="staff-btn staff-btn--ghost">Accept</button>\n                        </form>\n                      {% endif %}\n                      {% if can_modify_kds and row.next_status %}\n                        <form method="post" class="m-0">\n                          {% csrf_token %}\n                          <input type="hidden" name="order_id" value="{{ pack.order.id }}">\n                          <input type="hidden" name="line_id" value="{{ ln.id }}">\n                          <input type="hidden" name="kds_status" value="{{ row.next_status }}">\n                          {% if station_filter %}<input type="hidden" name="station" value="{{ station_filter }}">{% endif %}\n                          <button type="submit" class="staff-kds-action{% if row.next_status == \'ready\' %} staff-kds-action--ready{% else %} staff-kds-action--start{% endif %}">{% if row.next_status == \'ready\' %}<i class="bi bi-check2 me-1" aria-hidden="true"></i>{% else %}<i class="bi bi-play-fill me-1" aria-hidden="true"></i>{% endif %}{{ row.next_label }}</button>\n                        </form>\n                      {% else %}\n                        <span class="badge {% if ln.kds_status == \'ready\' %}bg-success{% else %}bg-secondary{% endif %}">{{ ln.get_kds_status_display }}</span>\n                      {% endif %}\n                      {% if can_manage_kds_priority %}\n                      <form method="post" class="m-0">{% csrf_token %}\n                        <input type="hidden" name="order_id" value="{{ pack.order.id }}">\n                        <input type="hidden" name="line_id" value="{{ ln.id }}">\n                        <input type="hidden" name="action" value="{% if ln.kds_rush %}normal{% else %}rush{% endif %}">\n                        {% if station_filter %}<input type="hidden" name="station" value="{{ station_filter }}">{% endif %}\n                        <button type="submit" class="staff-btn staff-btn--ghost">{% if ln.kds_rush %}Normal priority{% else %}Mark rush{% endif %}</button>\n                      </form>\n                      {% if ln.kds_status == \'ready\' %}\n                      <details class="kds-recall-control"><summary>Recall item</summary>\n                        <form method="post" class="kds-recall-form">{% csrf_token %}\n                          <input type="hidden" name="order_id" value="{{ pack.order.id }}">\n                          <input type="hidden" name="line_id" value="{{ ln.id }}">\n                          <input type="hidden" name="action" value="recall">\n                          {% if station_filter %}<input type="hidden" name="station" value="{{ station_filter }}">{% endif %}\n                          <label for="recall-{{ ln.id }}">Why prepare again?</label>\n                          <input id="recall-{{ ln.id }}" class="staff-input" name="reason" maxlength="255" placeholder="e.g. wrong preparation" required>\n                          <button type="submit" class="staff-btn staff-btn--ghost">Send back to prep</button>\n                        </form>\n                      </details>\n                      {% endif %}\n                      {% endif %}\n                    </div>\n                  </div>\n                {% endwith %}\n              {% endfor %}\n            </div>\n          </article>\n        {% endfor %}\n        </div>\n      </div>\n      </div>\n    {% endif %}\n  </div>\n{% endblock %}\n\n{% block extra_js %}\n  {# Literal kept for staff tests that assert a stable reconnect string in HTML. #}\n  <span class="visually-hidden">Reconnecting...</span>\n  <script>\n    window.STAFF_KDS_WS_BASE = "/ws/kds/";\n  </script>\n  <script src="{% static \'staff/staff-kds-live.js\' %}" defer></script>\n  {{ block.super }}\n{% endblock %}\n'
