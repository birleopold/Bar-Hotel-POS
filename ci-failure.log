mer account needed for a normal walk-in sale.</p>\n          </div>\n          <div class="d-flex flex-wrap gap-2">\n            {% if current_outlet and supermarket_shift_open %}\n              <form method="post" action="{% url \'staff-order-quick-create\' %}">\n                {% csrf_token %}\n                <button class="staff-btn staff-btn--primary staff-btn--touch" type="submit">Start checkout</button>\n              </form>\n            {% elif not supermarket_shift_open %}\n              <a class="staff-btn staff-btn--primary staff-btn--touch" href="{% url \'staff-pos-shifts\' %}">Open register first</a>\n            {% else %}\n              <span class="staff-muted small">Select a register to begin checkout.</span>\n            {% endif %}\n          </div>\n        </div>\n      </section>\n    {% endif %}\n\n    <section class="staff-pos-orders-lanes" aria-labelledby="staff-pos-lanes-heading">\n      <div class="staff-card staff-card--pos staff-card--soft staff-pos-orders-lanes-shell mb-0">\n        {% if show_supermarket_lane %}\n          <div class="visually-hidden orders-supermarket-lane-card" data-shift-status="{% if supermarket_shift_open %}open{% else %}closed{% endif %}">{% if staff_product.business_key == "retail" %}Retail lane{% else %}Supermarket lane{% endif %}</div>\n          <div class="staff-pos-supermarket-card" data-shift-status="{% if supermarket_shift_open %}open{% else %}closed{% endif %}">\n            <div>\n              <h3 class="staff-pos-supermarket-card__title"><i class="bi bi-shop me-2"></i>{% if staff_product.business_key == "retail" %}Retail checkout{% else %}Supermarket checkout{% endif %}</h3>\n              <p class="staff-pos-supermarket-card__status">Shift is {% if supermarket_shift_open %}<strong>Open</strong>{% else %}<strong>Closed</strong>{% endif %}</p>\n            </div>\n            <a href="{% url \'staff-pos-shifts\' %}" class="staff-btn staff-btn--sm staff-btn--ghost">Manage shift</a>\n          </div>\n        {% endif %}\n        <div class="staff-pos-orders-lanes__head">\n          <div>\n            <h2 id="staff-pos-lanes-heading" class="staff-card__title staff-card__title--pos mb-1">{% if show_supermarket_lane %}Checkout activity{% else %}Now serving{% endif %}</h2>\n            <p class="staff-muted mb-0">{% if show_supermarket_lane %}Held baskets, open checkouts, and recent sales.{% else %}Held tabs, walk-ins, and a short list of recent checks.{% endif %}</p>\n          </div>\n        </div>\n        <div id="staff-orders-lanes-scroll" class="staff-pos-orders-lanes-scroll" aria-label="{% if show_supermarket_lane %}Active checkouts{% else %}Active checks{% endif %}">\n          {% include "staff/includes/orders_lanes.html" %}\n        </div>\n      </div>\n    </section>\n    </div>\n\n    <section id="staff-orders-history" class="staff-pos-orders-history" aria-labelledby="staff-orders-history-heading">\n      <header class="staff-pos-orders-history__intro">\n        <div>\n          <h2 id="staff-orders-history-heading" class="staff-pos-orders-history__title">{% if show_supermarket_lane %}Past sales{% else %}Past orders{% endif %}</h2>\n          <p class="staff-muted mb-0 staff-pos-orders-history__subtitle">{% if show_supermarket_lane %}Search past receipts by reference or register.{% else %}Search by bill reference, tab, or section.{% endif %}</p>\n        </div>\n        {% if is_paginated %}\n          <p class="staff-pos-orders-history__count" aria-live="polite">\n            <span class="staff-pos-orders-history__count-strong">{{ page_obj.start_index }}–{{ page_obj.end_index }}</span>\n            <span class="text-muted"> of {{ paginator.count }}</span>\n          </p>\n        {% elif orders %}\n          <p class="staff-pos-orders-history__count"><span class="staff-pos-orders-history__count-strong">{{ orders|length }}</span><span class="text-muted"> shown</span></p>\n        {% endif %}\n      </header>\n\n      {% if returns_task %}<p class="staf