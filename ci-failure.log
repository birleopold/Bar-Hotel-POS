g/sites/"><i class="bi bi-geo-alt" aria-hidden="true"></i>Branches</a>\n    \n    <a href="/console/org/menu/items/"><i class="bi bi-box-seam" aria-hidden="true"></i>Products</a>\n    <a href="/console/org/menu/categories/"><i class="bi bi-tags" aria-hidden="true"></i>Categories</a>\n    \n    \n    \n    \n    <a href="/staff/settings/members/"><i class="bi bi-people" aria-hidden="true"></i>Staff</a>\n    <a href="/staff/pos/workstations/"><i class="bi bi-printer" aria-hidden="true"></i>Registers</a>\n    <a href="/staff/"><i class="bi bi-speedometer2" aria-hidden="true"></i>Operations</a>\n  </nav>\n  <div class="fizo-shell-help">One Fizo workspace for your enabled business lines.</div>\n</aside>\n\n\n    <div class="staff-app-shell__body">\n      <header class="staff-nav" role="banner">\n  <div class="fizo-shell-top">\n    <div><div class="fizo-shell-top__title">Console Org</div><div class="fizo-shell-top__subtitle">Unified business management</div></div>\n    <div class="fizo-shell-top__actions"><a href="/console/org/setup/"><i class="bi bi-list-check" aria-hidden="true"></i> Setup</a><a href="/staff/"><i class="bi bi-arrow-up-right-square" aria-hidden="true"></i> Workspace</a><span class="fizo-shell-top__user">fizo-reference-layout@test.local</span></div>\n  </div>\n</header>\n\n      <main class="staff-main staff-main--wide console-main fizo-setup-area staff-main--wide fizo-setup-page">\n        \n\n        \n\n<section class="grocery-setup" aria-labelledby="store-setup-heading">\n  <div class="grocery-setup__hero">\n    <div>\n      <p class="grocery-setup__eyebrow">Store management / Guided setup</p>\n      <h1 id="store-setup-heading">Set up your store</h1>\n      <p>Follow these steps in order to prepare your products, stock, staff and checkout. You can come back to any step later.</p>\n    </div>\n    <div class="grocery-setup__hero-actions">\n      <a class="staff-btn staff-btn--ghost" href="/staff/"><i class="bi bi-arrow-left"></i> Business overview</a>