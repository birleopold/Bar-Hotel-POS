active items linked to the selected section appear here.</p></div>\n  </div>\n\n  <div class="staff-menu-categories">\n    {% for cat in categories %}\n      <section class="staff-menu-category" aria-labelledby="menu-category-{{ cat.id }}">\n        <header class="staff-menu-category__head">\n          <span class="staff-menu-category__icon" aria-hidden="true"><i class="bi bi-grid" ></i></span>\n          <div class="staff-menu-category__title-wrap"><span class="staff-menu-category__eyebrow">Category</span><h3 id="menu-category-{{ cat.id }}">{{ cat.name }}</h3></div>\n          <span class="staff-menu-category__count">{{ cat.items.all|length }} item{{ cat.items.all|length|pluralize }}</span>\n        </header>\n        <div class="staff-menu-items">\n          {% for item in cat.items.all %}\n            <article class="staff-menu-item-card">\n              <div class="staff-menu-item-card__identity">\n                {% if item.display_image_url %}\n                  <img class="staff-menu-item-card__image" src="{{ item.display_image_url }}" alt="" loading="lazy">\n                {% else %}\n                  <span class="staff-menu-item-card__image staff-menu-item-card__image--placeholder" aria-hidden="true"><i class="bi bi-cup-hot"></i></span>\n                {% endif %}\n                <div class="staff-menu-item-card__copy">\n                  <h4>{{ item.name }}</h4>\n                  {% if item.sku %}<span class="staff-menu-item-card__sku">SKU {{ item.sku }}</span>{% endif %}\n                  {% if item.availability_note %}<p class="staff-menu-item-card__availability"><i class="bi bi-info-circle" aria-hidden="true"></i> {{ item.availability_note }}</p>{% endif %}\n                </div>\n              </div>\n              <div class="staff-menu-item-card__commercial">\n                <span>Unit price</span><strong>{{ item.unit_price }}</strong>\n                {% if item.is_featured %}<span class="staff-menu-featured"><i class="bi bi-stars" aria-hidden="true"></i> On Service TV</span>{% endif %}\n              </div>\n              {% if can_manage_tv_details and menu_scope_outlet and not menu_all_outlets_mode %}\n                <details class="staff-menu-item-card__details">\n                  <summary><i class="bi bi-sliders" aria-hidden="true"></i> Guest display</summary>\n                  <form method="post" class="staff-menu-display-form">\n                    {% csrf_token %}\n                    <input type="hidden" name="action" value="display_details">\n                    <input type="hidden" name="item_id" value="{{ item.id }}">\n                    <label class="staff-menu-featured-toggle"><input type="checkbox" name="is_featured" {% if item.is_featured %}checked{% endif %}><span>Include in featured rotation</span></label>\n                    <label>Public image URL<input class="staff-input" type="url" name="display_image_url" maxlength="200" value="{{ item.display_image_url }}" placeholder="https://…"></label>\n                    <label>Availability note<input class="staff-input" type="text" name="availability_note" maxlength="160" value="{{ item.availability_note }}" placeholder="e.g. Available until 8 pm"></label>\n                    <button class="staff-btn staff-btn--sm staff-btn--primary" type="submit"><i class="bi bi-check2 me-1" aria-hidden="true"></i>Save display details</button>\n                  </form>\n                </details>\n              {% endif %}\n            </article>\n          {% empty %}\n            <div class="staff-menu-category__empty">No sellable items in this category.</div>\n          {% endfor %}\n        </div>\n      </section>\n    {% empty %}\n      <div class="staff-menu-empty">\n        <span class="staff-menu-empty__icon"><i class="bi bi-journal-x" aria-hidden="true"></i></span>\n        <div><h2>No menu items in this view</h2><p>{% if menu_all_outlets_mode %}There are no active items linked to your sections.{% elif menu_scope_outlet %}Add active items