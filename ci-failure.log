"hidden" name="action" value="cash_movement"><input type="hidden" name="shift_id" value="{{ open_shift.pk }}">{{ movement_form.idempotency_key }}\n            {% if movement_form.non_field_errors %}<div role="alert">{{ movement_form.non_field_errors }}</div>{% endif %}\n            <div>{{ movement_form.direction.label_tag }}{{ movement_form.direction }}{{ movement_form.direction.errors }}</div><div>{{ movement_form.amount.label_tag }}{{ movement_form.amount }}{{ movement_form.amount.errors }}</div><div>{{ movement_form.reason.label_tag }}{{ movement_form.reason }}{{ movement_form.reason.errors }}</div>\n            <button class="staff-btn staff-btn--primary mt-2" type="submit">Record movement</button>\n          </form>\n          {% if cash_movements %}<h3 class="staff-card__title mt-3">Recent drawer movements</h3><ul>{% for m in cash_movements %}<li>{{ m.created_at }} · {{ m.get_direction_display }} · {{ shift_currency }} {{ m.amount }} · {{ m.reason }} · {{ m.recorded_by.email|default:"Former worker" }}</li>{% endfor %}</ul>{% endif %}\n        </details>\n        <form method="post" class="staff-register-form">\n          {% csrf_token %}\n          <input type="hidden" name="action" value="close_shift">\n          <input type="hidden" name="shift_id" value="{{ open_shift.id }}">\n          {% if close_form.non_field_errors %}<div class="staff-alert staff-alert--warning" role="alert">{{ close_form.non_field_errors }}</div>{% endif %}\n          <div class="mb-3"><label class="staff-label" for="{{ close_form.counted_cash.id_for_label }}">Cash physically counted ({{ shift_currency }})</label>{{ close_form.counted_cash }}{% for error in close_form.counted_cash.errors %}<span class="staff-field-error" role="alert">{{ error }}</span>{% endfor %}</div>\n          <div class="mb-3"><label for="{{ close_form.note.id_for_label }}">Variance explanation (required if cash differs)</label>{{ close_form.note }}{% for error in close_form.note.errors %}<span class="staff-field-error" role="alert">{{ error }}</span>{% endfor %}</div>\n          <button type="submit" class="staff-btn staff-btn--primary">Submit counted drawer</button>\n        </form>\n      </div>\n    {% elif not pending_handover %}\n      <div class="fizo-register__panel">\n        <h2 class="staff-card__title">Start a register shift</h2>\n        <p class="staff-muted">Count the opening cash float before taking the first sale.</p>\n        <form method="post" class="staff-register-form">\n          {% csrf_token %}\n          <input type="hidden" name="action" value="open_shift">\n          {% if open_form.non_field_errors %}<div class="staff-alert staff-alert--warning" role="alert">{{ open_form.non_field_errors }}</div>{% endif %}\n          <div class="mb-3"><label class="staff-label" for="{{ open_form.opening_cash.id_for_label }}">Opening cash float ({{ shift_currency }})</label>{{ open_form.opening_cash }}{% for error in open_form.opening_cash.errors %}<span class="staff-field-error" role="alert">{{ error }}</span>{% endfor %}</div>\n          <div class="mb-3">{{ open_form.note.label_tag }}{{ open_form.note }}{% for error in open_form.note.errors %}<span class="staff-field-error" role="alert">{{ error }}</span>{% endfor %}</div>\n          <button type="submit" class="staff-btn staff-btn--primary">Start shift</button>\n        </form>\n      </div>\n    {% endif %}\n    {% if pending_handover %}\n      <section class="fizo-register__panel" aria-labelledby="handover-title">\n        <h2 class="staff-card__title" id="handover-title">Handover · {{ pending_handover.get_status_display }}</h2>\n        <p class="staff-muted">Closed by {{ pending_handover.shift.closed_by.email|default:"Former worker" }} · expected {{ shift_currency }} {{ pending_handover.shift.expected_cash }} · submitted {{ shift_currency }} {{ pending_handover.shift.counted_cash }}{% if pending_handover.variance_explanation %} · {{ pending_handover.variance_explanation }}{% endif %}</p>\n        {% if 