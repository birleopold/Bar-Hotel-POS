            {% csrf_token %}\n                <button class="staff-btn staff-btn--primary staff-btn--touch" type="submit">Start checkout</button>\n              </form>\n            {% elif not supermarket_shift_open %}\n              <a class="staff-btn staff-btn--primary staff-btn--touch" href="{% url \'staff-pos-shifts\' %}">Open register first</a>\n            {% else %}\n              <span class="staff-muted small">Select a register to begin checkout.</span>\n            {% endif %}\n          </div>\n        </div>\n      </section>\n    {% endif %}\n\n    <section class="staff-pos-orders-lanes" aria-labelledby="staff-pos-lanes-heading">\n      <div class="staff-card staff-card--pos staff-card--soft staff-pos-orders-lanes-shell mb-0">\n        {% if show_supermarket_lane %}\n          <div class="visually-hidden orders-supermarket-lane-card" data-shift-status="{% if supermarket_shift_open %}open{% else %}closed{% endif %}">{% if staff_product.business_key == "retail" %}Retail lane{% else %}Supermarket lane{% endif %}</div>\n          <div class="staff-pos-supermarket-card" data-shift-status="{% if supermarket_shift_open %}open{% else %}closed{% endif %}">\n            <div>\n              <h3 class="staff-pos-supermarket-card__title"><i class="bi bi-shop me-2"></i>{% if staff_product.business_key == "retail" %}Retail checkout{% else %}Supermarket checkout{% endif %}</h3>\n              <p class="staff-pos-supermarket-card__status">Shift is {% if supermarket_shift_open %}<strong>Open</strong>{% else %}<strong>Closed</strong>{% endif %}</p>\n            </div>\n            <a href="{% url \'staff-pos-shifts\' %}" class="staff-btn staff-btn--sm staff-btn--ghost">Manage shift</a>\n          </div>\n        {% endif %}\n        <div class="staff-pos-orders-lanes__head">\n          <div>\n            <h2 id="staff-pos-lanes-heading" class="staff-card__title staff-card__title--pos mb-1">{% if show_supermarket_lane %}Checkout activity{% else %}Now serving{% endif %}</h2>\n            <p class="staff-muted mb-0">{% if show_supermarket_lane %}Held baskets, open checkouts, and recent sales.{% else %}Held tabs, walk-ins, and a short list of recent checks.{% endif %}</p>\n          </div>\n        </div>\n        <div id="staff-orders-lanes-scroll" class="staff-pos-orders-lanes-scroll" aria-label="{% if show_supermarket_lane %}Active checkouts{% else %}Active checks{% endif %}">\n          {% include "staff/includes/orders_lanes.html" %}\n        </div>\n      </div>\n    </section>\n    </div>\n\n    <section id="staff-orders-history" class="staff-pos-orders-history" aria-labelledby="staff-orders-history-heading">\n      <header class="staff-pos-orders-history__intro">\n        <div>\n          <h2 id="staff-orders-history-heading" class="staff-pos-orders-history__title">{% if show_supermarket_lane %}Past sales{% else %}Past orders{% endif %}</h2>\n          <p class="staff-muted mb-0 staff-pos-orders-history__subtitle">{% if show_supermarket_lane %}Search past receipts by reference or register.{% else %}Search by bill reference, tab, or section.{% endif %}</p>\n        </div>\n        {% if is_paginated %}\n          <p class="staff-pos-orders-history__count" aria-live="polite">\n            <span class="staff-pos-orders-history__count-strong">{{ page_obj.start_index }}–{{ page_obj.end_index }}</span>\n            <span class="text-muted"> of {{ paginator.count }}</span>\n          </p>\n        {% elif orders %}\n          <p class="staff-pos-orders-history__count"><span class="staff-pos-orders-history__count-strong">{{ orders|length }}</span><span class="text-muted"> shown</span></p>\n        {% endif %}\n      </header>\n\n      {% if returns_task %}<p class="staff-muted">Find the original closed receipt and open it to review returnable lines. Refunds require an authorized manager; existing return and payment rules still apply.</p>{% endif %}\n      <div class="staff-pos-orders-history__controls">\n        <nav class="staff-pos-orders-segments" aria-label="{% if show_supermarket_lane %}Sale status{% else %}Order status{% endif %}">\n          <a class="staff-pos-orders-seg{% if not status_filter %} staff-pos-orders-seg--active{% endif %}"{% if not status_filter %} aria-current="page"{% endif %} href="{% url \'staff-orders\' %}?{% if mine_filter %}mine=1&{% endif %}{% if q_filter %}q={{ q_filter|urlencode }}{% endif %}">All</a>\n          <a class="staff-pos-orders-seg{% if status_filter == \'open\' %} staff-pos-orders-seg--active{% endif %}"{% if status_filter == \'open\' %} aria-current="page"{% endif %} href="{% url \'staff-orders\' %}?status=open{% if mine_filter %}&mine=1{% endif %}{% if q_filter %}&q={{ q_filter|urlencode }}{% endif %}">Open</a>\n          <a class="staff-pos-orders-seg{% if status_filter == \'closed\' %} staff-pos-orders-seg--active{% endif %}"{% if status_filter == \'closed\' %} aria-current="page"{% endif %} href="{% url \'staff-orders\' %}?status=closed{% if mine_filter %}&mine=1{% endif %}{% if q_filter %}&q={{ q_filter|urlencode }}{% endif %}">Closed</a>\n          <a class="staff-pos-orders-seg{% if status_filter == \'cancelled\' %} staff-pos-orders-seg--active{% endif %}"{% if status_filter == \'cancelled\' %} aria-current="page"{% endif %} href="{% url \'staff-orders\' %}?status=cancelled{% if mine_filter %}&mine=1{% endif %}{% if q_filter %}&q={{ q_filter|urlencode }}{% endif %}">Cancelled</a>\n        </nav>\n        <a class="staff-btn staff-btn--ghost" href="{% url \'staff-orders\' %}{% if not mine_filter %}?mine=1{% endif %}">{% if mine_filter %}{% if show_supermarket_lane %}Everyone\'s sales{% else %}Everyone\'s orders{% endif %}{% else %}{% if show_supermarket_lane %}My sales{% else %}My orders{% endif %}{% endif %}</a>\n        <form class="staff-pos-orders-search" method="get" action="{% url \'staff-orders\' %}">\n          {% if returns_task %}<input type="hidden" name="task" value="returns">{% endif %}\n          {% if mine_filter %}<input type="hidden" name="mine" value="1">{% endif %}\n          {% if status_filter %}\n            <input type="hidden" name="status" value="{{ status_filter }}">\n          {% endif %}\n          <label class="visually-hidden" for="q">Search {% if show_supermarket_lane %}sales{% else %}orders{% endif %}</label>\n          <div class="staff-pos-orders-search__field">\n            <i class="bi bi-search staff-pos-orders-search__icon" aria-hidden="true"></i>\n            <input class="staff-input staff-pos-orders-search__input" id="q" name="q" type="search" value="{{ q_filter }}" placeholder="{% if show_supermarket_lane %}Receipt number, register, product…{% else %}Bill ref, tab name, outlet…{% endif %}" autocomplete="off">\n          </div>\n          <button type="submit" class="staff-btn staff-btn--primary staff-pos-orders-search__btn">Search</button>\n        </form>\n      </div>\n\n      <div class="staff-pos-orders-ledger" role="list">\n      {% for o in orders %}\n        <a class="staff-pos-order-card" role="listitem" href="{% url \'staff-order-detail\' order_id=o.id %}">\n          <div class="staff-pos-order-card__main">\n            <div class="staff-pos-order-card__title">{{ o.bill_reference }}</div>\n            <div class="staff-pos-order-card__meta">\n              <span>{{ o.outlet.name }}</span>\n              {% if not show_supermarket_lane and o.table_label %}<span>Tab: {{ o.table_label }}</span>{% endif %}\n            </div>\n          </div>\n          <div class="staff-pos-order-card__status">\n            <span class="staff-tag staff-tag--{% if o.status == \'open\' %}citrus{% elif o.status == \'closed\' %}teal{% else %}magenta{% endif %}">{{ o.get_status_display }}</span>\n          </div>\n          <div class="staff-pos-order-card__pricing">\n            <div class="staff-pos-order-card__total">{{ o.currency }} {{ o.total }}</div>\n            <div class="staff-pos-order-card__due">Paid {{ o.display_paid }} · Due {{ o.display_balance }}</div>\n          </div>\n          <div class="staff-pos-order-card__chevron">\n            <i class="bi bi-chevron-right"></i>\n          </div>\n        </a>\n      {% empty %}\n        {% url "staff-orders" as orders_url %}\n        {% if show_supermarket_lane %}{% include "staff/includes/empty_state.html" with title="No sales match your filters" message="Try changing the search or status, or start a new checkout." action_url=orders_url action_label="Reset filters" %}{% else %}{% include "staff/includes/empty_state.html" with title="No orders match your filters" message="Try clearing the status/search filters or create a new order tab." action_url=orders_url action_label="Reset filters" %}{% endif %}\n      {% endfor %}\n      </div>\n\n    {% if is_paginated %}\n      <nav class="staff-pager staff-pager--pos staff-pager--pos-footer" aria-label="{% if show_supermarket_lane %}Past sales pages{% else %}Past orders pages{% endif %}">\n        {% if page_obj.has_previous %}\n          <a class="staff-btn staff-btn--sm staff-btn--ghost" rel="prev" href="?page={{ page_obj.previous_page_number }}{% if status_filter %}&status={{ status_filter }}{% endif %}{% if returns_task %}&task=returns{% endif %}{% if mine_filter %}&mine=1{% endif %}{% if q_filter %}&q={{ q_filter|urlencode }}{% endif %}"><i class="bi bi-chevron-left me-1"></i>Newer</a>\n        {% else %}\n          <span class="staff-pager__spacer"></span>\n        {% endif %}\n        <span class="staff-pager__meta">Page {{ page_obj.number }} of {{ paginator.num_pages }}</span>\n        {% if page_obj.has_next %}\n          <a class="staff-btn staff-btn--sm staff-btn--ghost" rel="next" href="?page={{ page_obj.next_page_number }}{% if status_filter %}&status={{ status_filter }}{% endif %}{% if returns_task %}&task=returns{% endif %}{% if mine_filter %}&mine=1{% endif %}{% if q_filter %}&q={{ q_filter|urlencode }}{% endif %}">Older<i class="bi bi-chevron-right ms-1"></i></a>\n        {% else %}\n          <span class="staff-pager__spacer"></span>\n        {% endif %}\n      </nav>\n    {% endif %}\n    </section>\n  </div>\n{% endif %}\n{% endblock %}\n'
