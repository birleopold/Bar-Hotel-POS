i> Held sales</a>\n    </nav>\n  </section>\n  \n  <div class="staff-pos-order-layout">\n    \n      <section class="staff-pos-order-main fizo-checkout-catalogue" aria-label="Select products">\n            \n        <div class="staff-card staff-card--pos">\n          <div class="staff-pos-menu-head">\n            <div><span class="staff-pos-menu-eyebrow">PRODUCT CATALOGUE</span><h2 class="staff-card__title staff-card__title--pos mb-0">Add an item</h2></div>\n            <span class="staff-pos-menu-hint">Choose a product, set its quantity, then add to basket</span>\n          </div>\n              \n              <form method="get" class="fizo-server-catalogue-search" role="search">\n                <label for="fizo-catalogue-server-query">Search all available products</label>\n                <div><input id="fizo-catalogue-server-query" name="catalogue_q" value="" maxlength="80" type="search" placeholder="Product name, SKU or barcode" autocomplete="off">\n                <button type="submit" class="staff-btn staff-btn--primary">Search catalogue</button></div>\n                \n                \n              </form>\n              \n          \n          <div class="staff-empty-state"><p>No matching products. Try another name, SKU or barcode.</p></div>\n          \n\n          <form method="post" class="staff-pos-add-item-form" data-fizo-add-line-form>\n            <input type="hidden" name="csrfmiddlewaretoken" value="lXZxZ3rLAD5VHridfkHpIShQZeSoVm6zEJlaVEsJHcgRvA0lXKSNWBBjUupTVbVI">\n            <input type="hidden" name="action" value="add_line">\n            <div class="staff-pos-add-item-form__selection"><label class="staff-label" for="staff-pos-add-line-menu-item">Selected item</label><select name="menu_item" class="staff-input" id="staff-pos-add-line-menu-item" required>\n  <option value="" selected>Select item</option>\n\n</select></div>\n            <div class="staff-pos-add-item-form__quantity"><label for="id_quantity">Quantity:</label><input type="number" name="quantity" value="1" class="staff-input" step="0.001" min="0.001" required id="id_quantity"></div>\n            <div class="staff-pos-add-item-form__submit"><button type="submit" class="staff-btn staff-btn--primary staff-btn--touch"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add to basket</button></div>\n            <div class="staff-pos-add-item-form__modifiers" id="staff-pos-add-line-modifiers" aria-live="polite"></div>\n          </form>\n        </div>\n      \n\n\n      </section>\n    \n\n    <aside class="staff-pos-order-side staff-pos-panel-scroll" aria-label="Checkout actions">\n      \n      \n      <div class="fizo-checkout-basket" id="fizo-current-basket" aria-label="Current basket">\n        <div class="fizo-cashier-payment-summary" aria-label="Sale total and payment">\n          <span>Payable now</span><strong>USD 0</strong>\n          \n        </div>\n        <h2 class="fizo-checkout-basket__title"><i class="bi bi-cart3" aria-hidden="true"></i> Current basket <span>0 lines \xc2\xb7 B-5E5B896674</span></h2>\n        <nav class="fizo-retail-basket-tools" aria-label="Cashier shortcuts">\n          \n          <a href="#hold_label"><i class="bi bi-pause-circle" aria-hidden="true"></i> Hold Sale</a>\n          <a href="#void_reason" class="reference-clear-basket"><i class="bi bi-trash3" aria-hidden="true"></i> Clear Basket</a>\n          \n          \n          <a href="/staff/orders/bad8724f-fc67-4a44-b59e-61ca0f424e7a/print/?type=receipt&amp;format=80mm" target="_blank" rel="noopener"><i class="bi bi-printer" aria-hidden="true"></i> Print Receipt</a>\n          \n        </nav>\n    <section class="fizo-checkout-basket__lines" aria-label="Basket items">\n      <div class="fizo-retail-basket-items">\n        \n          <div class="fizo-retail-basket-empty"><i class="bi bi-basket2"></i><p>Basket empty. Scan a barcode or select a product to begin.</p></div>\n        \n      </div>\n    </section>\n    <div class="fizo-retail-basket-summary" aria-label="Sale totals">\n      <div><span>Subtotal</span><strong>USD 0.00</strong></div>\n      <div><span>Tax</span><strong>USD 0.00</strong></div>\n      <div class="fizo-retail-basket-summary__total"><span>Total due</span><strong>USD 0</strong></div>\n    </div>\n      </div>\n      \n      \n        <section class="reference-payment-idle" aria-label="Payment methods">\n          <h2>Payment</h2>\n          <div class="fizo-retail-payment-shortcuts" role="group" aria-label="Payment methods unavailable until items added">\n            <button type="button" disabled aria-disabled="true"><i class="bi bi-cash-stack"></i> Cash</button>\n            <button type="button" disabled aria-disabled="true"><i class="bi bi-credit-card"></i> Card</button>\n            <button type="button" disabled aria-disabled="true"><i class="bi bi-phone"></i> Mobile Money</button>\n          </div>\n          <p>Add an item to enable payment.</p>\n        </section>\n      \n      \n\n      \n\n      \n\n      \n\n      \n        <div class="staff-card staff-card--pos">\n          <h2 class="staff-card__title staff-card__title--pos">Hold / void</h2>\n          <div class="row g-2" data-pos-hold-mask>\n            <div class="col-12 col-md-6">\n              <form method="post">\n                <input type="hidden" name="csrfmiddlewaretoken" value="lXZxZ3rLAD5VHridfkHpIShQZeSoVm6zEJlaVEsJHcgRvA0lXKSNWBBjUupTVbVI">\n                <input type="hidden" name="action" value="hold_order">\n                <label class="staff-label" for="hold_label">Hold</label>\n                <input class="staff-input mb-2" id="hold_label" name="hold_label" maxlength="64" placeholder="Basket note (optional)" autocomplete="off" data-pos-hold-input>\n                <button type="submit" class="staff-btn staff-btn--ghost staff-btn--touch" data-pos-hold-save>Hold</button>\n              </form>\n            </div>\n            <div class="col-12 col-md-6">\n              <form method="post">\n                <input type="hidden" name="csrfmiddlewaretoken" value="lXZxZ3rLAD5VHridfkHpIShQZeSoVm6zEJlaVEsJHcgRvA0lXKSNWBBjUupTVbVI">\n                <input type="hidden" name="action" value="void_order">\n                <label class="staff-label" for="void_reason">Void all</label>\n                <input class="staff-input mb-2" id="void_reason" name="reason" maxlength="255" placeholder="Reason" autocomplete="off">\n                <button type="submit" class="staff-btn staff-btn--ghost staff-btn--touch">Void</button>\n              </form>\n            </div>\n          </div>\n        </div>\n      \n\n      \n\n      \n\n\n \n  <details class="staff-card fizo-quick-product" id="fizo-quick-product">\n    <summary><i class="bi bi-plus-square"></i> Product missing? Add &amp; sell now</summary>\n    <p class="staff-muted small mt-2">Enter the name and selling price. The system adds the product to this basket, records who created it and flags its catalogue record for review. This does not create stock quantities.</p>\n    <form method="post" class="fizo-quick-product__form" data-fizo-quick-product-form>\n      <input type="hidden" name="csrfmiddlewaretoken" value="lXZxZ3rLAD5VHridfkHpIShQZeSoVm6zEJlaVEsJHcgRvA0lXKSNWBBjUupTVbVI">\n      <input type="hidden" name="action" value="quick_create_product">\n      <input type="hidden" name="quick_product_request_key" value="0fda61a3-5c52-4cdd-bee2-7f23510dc2c5">\n      <label>Product name<input class="staff-input" name="name" required minlength="2" maxlength="255" autocomplete="off" placeholder="e.g. New kitchen soap"></label>\n      <label>Unit selling price (USD)<input class="staff-input" name="unit_price" type="number" inputmode="decimal" min="0.01" step="0.01" required></label>\n      <label>Quantity<input class="staff-input" name="quantity" type="number" inputmode="decimal" min="0.001" step="0.001" value="1" required></label>\n      <label>Barcode (optional)<input class="staff-input" name="barcode" maxlength="64" autocomplete="off" placeholder="Only if known"></label>\n      <button class="staff-btn staff-btn--primary" type="submit">Save product &amp; add to basket</button>\n    </form>\n  </details>\n  \n\n  <div class="staff-toolbar mt-2 mb-3"><a class="staff-btn staff-btn--ghost" target="_blank" rel="noopener" href="/staff/orders/bad8724f-fc67-4a44-b59e-61ca0f424e7a/display/">Open customer display on second screen</a>\n    <p class="staff-muted small mb-0">Read-only, staff-session protected. Move this tab to the second monitor; public access is disabled.</p></div>\n  \n    <div class="staff-card" id="retail-fast-checkout" aria-label="Fast supermarket checkout">\n      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">\n        <div><h2 class="staff-card__title mb-1">Scan items</h2><p class="staff-muted small mb-0">Scan a barcode or enter a product code. Press Enter to add it. Set quantity only when selling multiple items or measured goods.</p></div>\n        <span class="staff-tag">Scan or enter PLU</span>\n      </div>\n      <form method="post" class="row g-3 align-items-end" data-retail-scan-form>\n        <input type="hidden" name="csrfmiddlewaretoken" value="lXZxZ3rLAD5VHridfkHpIShQZeSoVm6zEJlaVEsJHcgRvA0lXKSNWBBjUupTVbVI">\n        <input type="hidden" name="action" value="scan_add_line">\n        <div class="col-md-6"><label for="id_code">Code:</label><input type="text" name="code" class="staff-input" maxlength="64" placeholder="Scan barcode / enter PLU" autocomplete="off" required id="id_code"></div>\n        <div class="col-md-3"><label for="id_quantity">Quantity:</label><input type="number" name="quantity" value="1" class="staff-input" step="0.001" min="0.001" required id="id_quantity"></div>\n        <div class="col-md-3"><button type="submit" class="staff-btn staff-btn--primary staff-btn--touch" data-retail-scan-submit>Add item</button></div>\n      </form>\n      <p class="staff-muted small mt-2 mb-0" role="status" data-retail-scan-status aria-live="polite">Scanner ready. Each successful scan updates the basket using the existing stock and pricing rules.</p>\n    </div>\n  \n  \n  \n  \n  <section class="staff-card mb-3" aria-label="Wholesale prices">\n    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">\n      <div><h2 class="staff-card__title">Wholesale quantity pricing</h2>\n      <p class="staff-muted small">Only for identified customers and authorized managers. Regular walk-in shoppers keep shelf prices. Never combined with an order promotion.</p></div>\n      <a class="staff-btn staff-btn--ghost" href="/staff/pos/wholesale-prices/">Manage tiers</a>\n    </div>\n    <p class="staff-muted">Link the customer\'s verified profile before recording payment to enable wholesale approval. Manager rights required.</p>\n  </section>\n  \n    <div class="staff-card">\n      <h2 class="staff-card__title">Line discount</h2>\n      <p class="staff-muted">Choose the item to discount, then enter an amount or percent.</p>\n      \n\n      <form method="post" class="row g-2 align-items-end">\n        <input type="hidden" name="csrfmiddlewaretoken" value="lXZxZ3rLAD5VHridfkHpIShQZeSoVm6zEJlaVEsJHcgRvA0lXKSNWBBjUupTVbVI">\n        <input type="hidden" name="action" value="line_discount">\n        <div class="col-md-3">\n          <label class="staff-label" for="disc_line">Order item</label>\n          <select class="staff-input" id="disc_line" name="line_id" required>\n            <option value="">Select an item</option>\n            \n          </select>\n        </div>\n        <div class="col-md-3"><label for="id_discount_amount">Discount amount:</label><input type="number" name="discount_amount" class="staff-input" step="0.01" min="0" id="id_discount_amount"></div>\n        <div class="col-md-3"><label for="id_discount_percent">Discount percent:</label><input type="number" name="discount_percent" class="staff-input" step="0.01" min="0" max="100" id="id_discount_percent"></div>\n        <div class="col-md-3"><button type="submit" class="staff-btn staff-btn--ghost">Apply</button></div>\n      </form>\n    </div>\n  \n  \n  \n  \n\n    </aside>\n  </div>\n\n    </main>\n    </div></div>\n  \n  \n    \n<dialog id="staff-command-dialog" class="staff-command-dialog" aria-labelledby="staff-command-title">\n  <div class="staff-command-head">\n    <div>\n      <h2 id="staff-command-title">Find a record</h2>\n      <p>Search the areas you are allowed to use.</p>\n    </div>\n    <form method="dialog"><button class="staff-command-close" type="submit" aria-label="Close search">Close <span aria-hidden="true">\xc3\x97</span></button></form>\n  </div>\n  <div class="staff-command-field">\n    <label class="visually-hidden" for="staff-command-input">Search workspace records</label>\n    <input id="staff-command-input" type="search" role="combobox" aria-autocomplete="list"\n      aria-expanded="false" aria-controls="staff-command-results"\n      autocomplete="off" maxlength="80" placeholder="Order, guest, room, item, supplier\xe2\x80\xa6">\n    <kbd>ESC</kbd>\n  </div>\n  <p id="staff-command-feedback" class="staff-command-feedback" role="status" aria-live="polite">Type two or more characters to search.</p>\n  <div id="staff-command-results" class="staff-command-results" role="listbox" aria-label="Matching workspace records"></div>\n  <footer class="staff-command-footer">\n    <span>\xe2\x86\x91 \xe2\x86\x93 to select \xc2\xb7 Enter to open</span>\n    <a href="/staff/search/">Open full search</a>\n  </footer>\n</dialog>\n<script src="/static/staff/staff-command.js?v=20261016.1" defer></script>\n\n  \n  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>\n  \n<script>\n(function(){\n  function start(){\n    var catalog=document.querySelector(\'.fizo-checkout-catalogue\');\n    var basket=document.querySelector(\'.fizo-checkout-basket\');\n    var search=document.querySelector(\'[data-pos-menu-search]\');\n    var scan=document.querySelector(\'[data-retail-scan-form] input[name="code"]\');\n    if(basket) basket.id=\'fizo-current-basket\';\n    if(search){ search.id=\'fizo-pos-menu-search\'; search.setAttribute(\'aria-label\',\'Find product by name, barcode or SKU\'); }\n    function activate(selector,input){\n      var link=document.querySelector(selector);\n      if(!link)return;\n      link.addEventListener(\'click\',function(e){\n        if(!input)return;\n        e.preventDefault();input.focus();input.select();\n        if(catalog && input===search)catalog.scrollIntoView({behavior:\'smooth\',block:\'start\'});\n      });\n    }\n    activate(\'[data-fizo-focus-search]\',search);\n    activate(\'[data-fizo-focus-scan]\',scan);\n    document.addEventListener(\'keydown\',function(e){\n      if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()===\'k\'&&search){e.preventDefault();search.focus();search.select();}\n    });\n  }\n  if(document.readyState===\'loading\')document.addEventListener(\'DOMContentLoaded\',start);else start();\n})();\n</script>\n\n\n  \n  <script defer src="/static/staff/retail-counter-v2.js?v=20261023.15"></script>\n  \n    <script id="staff-pos-menu-modifiers" type="application/json">{}</script>\n    <script>\n      (function () {\n        var dataEl = document.getElementById("staff-pos-menu-modifiers");\n        var sel = document.getElementById("staff-pos-add-line-menu-item");\n        var host = document.getElementById("staff-pos-add-line-modifiers");\n        if (!dataEl || !sel || !host) return;\n        var map = {};\n        try {\n          map = JSON.parse(dataEl.textContent) || {};\n        } catch (e) {\n          return;\n        }\n        function render() {\n          host.innerHTML = "";\n          var id = sel.value || "";\n          var groups = map[id] || [];\n          if (!groups.length) return;\n          for (var gi = 0; gi < groups.length; gi++) {\n            var g = groups[gi];\n            var wrap = document.createElement("div");\n            wrap.className = "mb-2";\n            var cap = document.createElement("div");\n            cap.className = "staff-label small mb-1";\n            var hint = g.name;\n            if (g.min > 0) {\n              hint += " (choose at least " + g.min + ")";\n            }\n            if (g.max != null) {\n              hint += " \xc2\xb7 max " + g.max;\n            }\n            cap.textContent = hint;\n            wrap.appendChild(cap);\n            var opts = g.options || [];\n            for (var oi = 0; oi < opts.length; oi++) {\n              var o = opts[oi];\n              var lab = document.createElement("label");\n              lab.className = "staff-muted d-block small mb-1";\n              var inp = document.createElement("input");\n              inp.type = "checkbox";\n              inp.name = "modifier_option";\n              inp.value = o.id;\n              inp.className = "me-1";\n              lab.appendChild(inp);\n              var extra = o.name;\n              if (o.price_delta && o.price_delta !== "0.00") {\n                extra += " (+" + o.price_delta + ")";\n              }\n              lab.appendChild(document.createTextNode(extra));\n              wrap.appendChild(lab);\n            }\n            host.appendChild(wrap);\n          }\n        }\n        sel.addEventListener("change", render);\n        render();\n      })();\n    </script>\n    <script>\n      (function () {\n        var browser = document.querySelector("[data-pos-menu-browser]");\n        var select = document.getElementById("staff-pos-add-line-menu-item");\n        if (!browser || !select) return;\n        var search = browser.querySelector("[data-pos-menu-search]");\n        var tiles = Array.prototype.slice.call(browser.querySelectorAll("[data-pos-menu-tile]"));\n        var filters = Array.prototype.slice.call(browser.querySelectorAll("[data-pos-menu-filter]"));\n        var empty = browser.querySelector("[data-pos-menu-empty]");\n        var announcement = browser.querySelector("[data-pos-menu-selection]");\n        var activeCategory = "all";\n        var quickPicks = browser.querySelector("[data-fizo-favourites]");\n        if (quickPicks) {\n          var ranked = tiles.filter(function (tile) { return tile.dataset.fizoQuickPick === "1"; });\n          if (ranked.length) {\n            quickPicks.textContent = "";\n            ranked.forEach(function (tile) {\n              var shortcut = document.createElement("button");\n              shortcut.type = "button";\n              shortcut.className = "fizo-pos-quick-pick";\n              shortcut.textContent = tile.querySelector(".staff-pos-menu-tile__name").textContent;\n              shortcut.addEventListener("click", function () {\n                activeCategory = "all";\n                filters.forEach(function (filter) {\n                  var active = filter.dataset.posMenuFilter === "all";\n                  filter.classList.toggle("is-active", active);\n                  filter.setAttribute("aria-pressed", active ? "true" : "false");\n                });\n                if (search) search.value = "";\n                updateTiles();\n                tile.click();\n              });\n              quickPicks.appendChild(shortcut);\n            });\n          }\n        }\n\n        var pageSize = browser.querySelector("[data-fizo-page-controls]") ? 40 : Infinity;\n        var pageLimit = pageSize;\n        var moreControls = browser.querySelector("[data-fizo-page-controls]");\n        var moreButton = browser.querySelector("[data-fizo-load-more]");\n        var visibleLabel = browser.querySelector("[data-fizo-visible-count]");\n        function updateTiles() {\n          var query = (search && search.value || "").trim().toLowerCase();\n          var found = 0, visibleCount = 0;\n          tiles.forEach(function (tile) {\n            var matchesCategory = activeCategory === "all" || tile.dataset.categoryId === activeCategory;\n            var matchesSearch = !query || [tile.dataset.itemName, tile.dataset.itemSku, tile.dataset.itemBarcode].some(function (value) { return (value || "").indexOf(query) !== -1; });\n            var match = matchesCategory && matchesSearch;\n            if (match) found += 1;\n            var shown = match && visibleCount < pageLimit;\n            tile.hidden = !shown;\n            if (shown) visibleCount += 1;\n          });\n          if (empty) empty.hidden = found !== 0;\n          if (moreControls) {\n            moreControls.hidden = found <= pageSize;\n            if (visibleLabel) visibleLabel.textContent = "Showing " + visibleCount + " of " + found + " matching products";\n            if (moreButton) moreButton.hidden = visibleCount >= found;\n          }\n        }\n        if (moreButton) moreButton.addEventListener("click", function () {\n          pageLimit += pageSize;\n          updateTiles();\n        });\n\n        filters.forEach(function (filter) {\n          filter.addEventListener("click", function () {\n            activeCategory = filter.dataset.posMenuFilter || "all";\n            pageLimit = pageSize;\n            filters.forEach(function (other) {\n              var active = other === filter;\n              other.classList.toggle("is-active", active);\n              other.setAttribute("aria-pressed", active ? "true" : "false");\n            });\n            updateTiles();\n          });\n        });\n        if (search) search.addEventListener("input", function () { pageLimit = pageSize; updateTiles(); });\n        var clearSearch = browser.querySelector("[data-fizo-search-clear]");\n        if (clearSearch && search) clearSearch.addEventListener("click", function () {\n          search.value = "";\n          search.focus();\n          updateTiles();\n        });\n\n        tiles.forEach(function (tile) {\n          tile.addEventListener("click", function () {\n            var itemId = tile.dataset.itemId || "";\n            select.value = itemId;\n            select.dispatchEvent(new Event("change", { bubbles: true }));\n            tiles.forEach(function (other) {\n              var active = other === tile;\n              other.classList.toggle("is-selected", active);\n              other.setAttribute("aria-pressed", active ? "true" : "false");\n            });\n            var option = select.options[select.selectedIndex];\n            if (announcement && option) announcement.textContent = option.text + " selected. Set quantity and add it to the order.";\n          });\n        });\n        select.addEventListener("change", function () {\n          var selected = tiles.find(function (tile) { return tile.dataset.itemId === select.value; });\n          tiles.forEach(function (tile) {\n            var active = tile === selected;\n            tile.classList.toggle("is-selected", active);\n            tile.setAttribute("aria-pressed", active ? "true" : "false");\n          });\n        });\n        updateTiles();\n      })();\n    </script>\n  \n\n<script src="/static/staff/grocery-checkout.js?v=20261022.2" defer></script>\n<script>\n/* Manual selection never submits a sale. Only the explicit Add button does.\n   Barcode submission continues through the dedicated scanner form. */\n</script>\n\n<script>\n(function () {\n  "use strict";\n  var form = document.querySelector("[data-retail-scan-form]");\n  if (form) {\n    var input = form.querySelector(\'input[name="code"]\');\n    var quantity = form.querySelector(\'input[name="quantity"]\');\n    var button = form.querySelector("[data-retail-scan-submit]");\n    var status = document.querySelector("[data-retail-scan-status]");\n    if (input && button) {\n      input.setAttribute("aria-label", "Barcode or product lookup code");\n      input.setAttribute("enterkeyhint", "done");\n      // Header search owns initial focus on desktop; never focus a hidden scanner.\n      document.addEventListener("keydown", function (event) {\n        if (event.key !== "/" || event.ctrlKey || event.altKey || event.metaKey || event.repeat) return;\n        var target = event.target;\n        if (target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;\n        event.preventDefault();\n        var top = document.getElementById("reference-top-catalogue-search");\n        if(top){top.focus();top.select();}else{input.focus();input.select();}\n      });\n      var submitted = false;\n      form.addEventListener("submit", function (event) {\n        if (submitted) { event.preventDefault(); return; }\n        if (!input.value.trim()) {\n          event.preventDefault();\n          input.focus();\n          if (status) status.textContent = "Scan a barcode or type a PLU first.";\n          return;\n        }\n        var qty = quantity ? Number(quantity.value) : 1;\n        if (!Number.isFinite(qty) || qty <= 0 || Math.round(qty * 1000) !== qty * 1000) {\n          event.preventDefault();\n          if (quantity) quantity.focus();\n          if (status) status.textContent = "Enter a positive quantity with at most three decimal places.";\n          return;\n        }\n        submitted = true;\n        button.disabled = true;\n        if (status) status.textContent = "Adding item to basket\xe2\x80\xa6";\n      });\n    }\n  }\n  var paymentSubmitForm = document.querySelector("[data-pos-payment-form]");\n  if (paymentSubmitForm) {\n    var paymentPending = false;\n    paymentSubmitForm.addEventListener("submit", function (event) {\n      if (paymentPending) { event.preventDefault(); return; }\n      if (!paymentSubmitForm.checkValidity()) return;\n      paymentPending = true;\n      var submitButton = paymentSubmitForm.querySelector(\'button[type="submit"]\');\n      if (submitButton) {\n        submitButton.disabled = true;\n        submitButton.textContent = "Recording payment\xe2\x80\xa6";\n      }\n    });\n  }\n  var cashPanel = document.querySelector(