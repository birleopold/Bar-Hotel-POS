 aria-hidden="true"></i></strong></a></li>\n          {% endfor %}</ul>\n        {% else %}<p class="fizo-dash__empty">Nothing requiring attention is available yet.</p>{% endif %}\n      </section>\n      <section class="fizo-dash__panel staff-panel" aria-labelledby="fizo-activity-title">\n        <div class="fizo-dash__sectionhead"><h2 id="fizo-activity-title">{% if staff_dashboard_lodging_snapshot %}Today\'s arrivals{% elif staff_dashboard_low_stock_rows %}Stock alerts{% else %}Quick access{% endif %}</h2></div>\n        {% if staff_dashboard_lodging_snapshot and staff_dashboard_lodging_snapshot.arrival_rows %}\n          <ul class="fizo-dash__list">{% for row in staff_dashboard_lodging_snapshot.arrival_rows %}<li><a href="{{ row.detail_url }}"><span><strong>{{ row.guest_name }}</strong><small class="d-block">{{ row.status_label }}</small></span><span class="fizo-dash__pill">{{ row.room_label }}</span></a></li>{% endfor %}</ul>\n        {% elif staff_dashboard_low_stock_rows %}\n          <ul class="fizo-dash__list">{% for row in staff_dashboard_low_stock_rows %}<li><span><strong>{{ row.menu_item_name }}</strong><small class="d-block">{{ row.outlet_name }}</small></span><strong>{{ row.quantity }}</strong></li>{% endfor %}</ul>\n          {% if staff_dashboard_low_stock_url %}<a class="fizo-dash__action fizo-dash__action--secondary mt-3" href="{{ staff_dashboard_low_stock_url }}">Review stock</a>{% endif %}\n        {% else %}\n          <div class="fizo-dash__links">\n            {% if staff_nav.orders %}<a href="{% url \'staff-orders\' %}">Orders</a>{% endif %}\n            {% if staff_nav.menu %}<a href="{% url \'staff-menu\' %}">Items</a>{% endif %}\n            {% if staff_nav.inventory %}<a href="{% url \'staff-inventory-balances\' %}">Stock</a>{% endif %}\n            {% if staff_nav.lodging %}<a href="{% url \'staff-lodging-reservations\' %}">Reservations</a>{% endif %}\n          </div>\n        {% endif %}\n      </section>\n    </div>\n\n    {% if staff_dashboard_primary_actions or staff_dashboard_secondary_actions %}\n    <section class="fizo-dash__section" aria-labelledby="fizo-shortcuts-title">\n      <div class="fizo-dash__sectionhead"><h2 id="fizo-shortcuts-title">Quick actions</h2></div>\n      <div class="fizo-dash__shortcuts">\n        {% for action in staff_dashboard_primary_actions %}\n          {% if action.method == "post" %}<form method="post" action="{{ action.url }}">{% csrf_token %}<button type="submit"><i class="bi bi-{{ action.icon }}" aria-hidden="true"></i>{{ action.label }}</button></form>\n          {% else %}<a href="{{ action.url }}"><i class="bi bi-{{ action.icon }}" aria-hidden="true"></i>{{ action.label }}</a>{% endif %}\n        {% endfor %}\n        {% for action in staff_dashboard_secondary_actions %}\n          {% if action.method == "post" %}<form method="post" action="{{ action.url }}">{% csrf_token %}<button type="submit"><i class="bi bi-arrow-up-right" aria-hidden="true"></i>{{ action.label }}</button></form>\n          {% else %}<a href="{{ action.url }}"><i class="bi bi-arrow-up-right" aria-hidden="true"></i>{{ action.label }}</a>{% endif %}\n        {% endfor %}\n      </div>\n    </section>{% endif %}\n\n    {% if show_workspace_admin_tools %}\n    <section class="fizo-dash__panel fizo-dash__section">\n      <div class="fizo-dash__sectionhead"><h2>Business management</h2></div>\n      <div class="fizo-dash__links"><a href="{% url \'console-org\' %}">Business overview</a><a href="{% url \'console-org-setup\' %}">Guided setup</a><a href="{% url \'staff-workspace-members\' %}">Staff</a></div>\n    </section>{% elif show_workspace_setup_cta %}\n    <section class="fizo-dash__panel fizo-dash__section"><p>Business setup needs attention.</p><a href="{{ tenant_setup_url }}" class="fizo-dash__action">Review setup</a></section>\n    {% endif %}\n    {% if memberships|length > 1 %}\n      <form method="post" action="{% url \'staff-select-tenant\' %}" class="fizo-dash__panel fizo-dash__section">{% csrf_token %}\n        <label for="fizo-switch">Change workspace</label><select id="fizo-switch" class="staff-input" name="tenant_id">{% for m in memberships %}<option value="{{ m.tenant_id }}"{% if m.tenant_id == active_membership.tenant_id %} selected{% endif %}>{{ m.tenant.name }}</option>{% endfor %}</select>\n        <button class="fizo-dash__action" type="submit">Switch</button>\n      </form>\n    {% endif %}\n  {% endif %}\n</div>\n{% endblock %}\n'
