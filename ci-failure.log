e="hidden" name="next" value="/console/org/setup/">\n                <button name="state" value="blocked" type="submit">Mark as blocked</button>\n                <button name="state" value="" type="submit">Clear blocked flag</button>\n              </form>\n            </details>\n            \n        </article>\n      \n        <article class="staff-card grocery-setup__step grocery-setup__step--done">\n          <span class="grocery-setup__step-icon" aria-hidden="true">2</span>\n          <span class="grocery-setup__step-visual" aria-hidden="true"><i class="bi bi-building"></i></span>\n          <div class="grocery-setup__step-body">\n            <h3>Create your first branch</h3>\n            <p>Add at least one physical location for this workspace.</p>\n          </div>\n          <div class="grocery-setup__step-actions">\n              <a class="staff-btn staff-btn--sm staff-btn--ghost" href="/console/org/sites/new/">Create branch <i class="bi bi-arrow-right"></i></a>\n              \n              <span class="grocery-setup__status grocery-setup__status--done"><i class="bi bi-check-circle-fill"></i> Done</span>\n            </div>\n            \n            <details class="grocery-setup__more">\n              <summary>Problem with this step?</summary>\n              <form method="post" action="/console/org/setup/step-state/">\n                <input type="hidden" name="csrfmiddlewaretoken" value="cYOjgO5c7vBGzs4coFMlYSmHbS6YonuQdxvhQO7C3GgsQ6h6tGpm6VdrZRUQyI3L">\n                <input type="hidden" name="step_key" value="first_property">\n                <input type="hidden" name="next" value="/console/org/setup/">\n                <button name="state" value="blocked" type="submit">Mark as blocked</button>\n                <button name="state" value="" type="submit">Clear blocked flag</button>\n              </form>\n            </details>\n            \n        </article>\n      \n        <article class="staff-card grocery-setup__step grocery-setup__step--done">\n          <span class="grocery-setup__step-icon" aria-hidden="true">3</span>\n          <span class="grocery-setup__step-visual" aria-hidden="true"><i class="bi bi-geo-alt"></i></span>\n          <div class="grocery-setup__step-body">\n            <h3>Add a section under that branch</h3>\n            <p>Define the locations and work areas your team operates.</p>\n          </div>\n          <div class="grocery-setup__step-actions">\n              <a class="staff-btn staff-btn--sm staff-btn--ghost" href="/console/org/sites/1287bf1b-1f01-4f7b-96f9-39f5ef513073/outlets/new/">Create first section <i class="bi bi-arrow-right"></i></a>\n              \n              <span class="grocery-setup__status grocery-setup__status--done"><i class="bi bi-check-circle-fill"></i> Done</span>\n            </div>\n            \n            <details class="grocery-setup__more">\n              <summary>Problem with this step?</summary>\n              <form method="post" action="/console/org/setup/step-state/">\n                <input type="hidden" name="csrfmiddlewaretoken" value="cYOjgO5c7vBGzs4coFMlYSmHbS6YonuQdxvhQO7C3GgsQ6h6tGpm6VdrZRUQyI3L">\n                <input type="hidden" name="step_key" value="first_outlet">\n                <input type="hidden" name="next" value="/console/org/setup/">\n                <button name="state" value="blocked" type="submit">Mark as blocked</button>\n                <button name="state" value="" type="submit">Clear blocked flag</button>\n              </form>\n            </details>\n            \n        </article>\n      \n        <article class="staff-card grocery-setup__step grocery-setup__step--done">\n          <span class="grocery-setup__step-icon" aria-hidden="true">4</span>\n          <span class="grocery-setup__step-visual" aria-hidden="true"><i class="bi bi-check2-square"></i></span>\n          <div class="grocery-setup__step-body">\n            <h3>Seed items and services</h3>\n            <p>Create your first item category or add your first service.</p>\n          </div>\n          <div class="grocery-setup__step-actions">\n              <a class="staff-btn staff-btn--sm staff-btn--ghost" href="/console/org/menu/categories/new/">Create item category <i class="bi bi-arrow-right"></i></a>\n              \n              <span class="grocery-setup__status grocery-setup__status--done"><i class="bi bi-check-circle-fill"></i> Done</span>\n            </div>\n            \n            <details class="grocery-setup__more">\n              <summary>Problem with this step?</summary>\n              <form method="post" action="/console/org/setup/step-state/">\n                <input type="hidden" name="csrfmiddlewaretoken" value="cYOjgO5c7vBGzs4coFMlYSmHbS6YonuQdxvhQO7C3GgsQ6h6tGpm6VdrZRUQyI3L">\n                <input type="hidden" name="step_key" value="first_menu_category">\n                <input type="hidden" name="next" value="/console/org/setup/">\n                <button name="state" value="blocked" type="submit">Mark as blocked</button>\n                <button name="state" value="" type="submit">Clear blocked flag</button>\n              </form>\n            </details>\n            \n        </article>\n      \n        <article class="staff-card grocery-setup__step grocery-setup__step--done">\n          <span class="grocery-setup__step-icon" aria-hidden="true">5</span>\n          <span class="grocery-setup__step-visual" aria-hidden="true"><i class="bi bi-check2-square"></i></span>\n          <div class="grocery-setup__step-body">\n            <h3>Add at least one sellable item or service</h3>\n            <p>A category alone cannot be sold. Create an item with a price or a service offering.</p>\n          </div>\n          <div class="grocery-setup__step-actions">\n              <a class="staff-btn staff-btn--sm staff-btn--ghost" href="/console/org/menu/items/new/">Add first item <i class="bi bi-arrow-right"></i></a>\n              \n              <span class="grocery-setup__status grocery-setup__status--done"><i class="bi bi-check-circle-fill"></i> Done</span>\n            </div>\n            \n            <details class="grocery-setup__more">\n              <summary>Problem with this step?</summary>\n              <form method="post" action="/console/org/setup/step-state/">\n                <input type="hidden" name="csrfmiddlewaretoken" value="cYOjgO5c7vBGzs4coFMlYSmHbS6YonuQdxvhQO7C3GgsQ6h6tGpm6VdrZRUQyI3L">\n                <input type="hidden" name="step_key" value="first_sellable">\n                <input type="hidden" name="next" value="/console/org/setup/">\n                <button name="state" value="blocked" type="submit">Mark as blocked</button>\n                <button name="state" value="" type="submit">Clear blocked flag</button>\n              </form>\n            </details>\n            \n        </article>\n      \n        <article class="staff-card grocery-setup__step">\n          <span class="grocery-setup__step-icon" aria-hidden="true">6</span>\n          <span class="grocery-setup__step-visual" aria-hidden="true"><i class="bi bi-check2-square"></i></span>\n          <div class="grocery-setup__step-body">\n            <h3>Set up the counter or device</h3>\n            <p>Name the staff till or workstation and assign it to a section. Browser pairing can be required.</p>\n          </div>\n          <div class="grocery-setup__step-actions">\n              <a class="staff-btn staff-btn--sm staff-btn--primary" href="/staff/pos/workstations/new/">Set up workstation <i class="bi bi-arrow-right"></i></a>\n              <a class="staff-btn staff-btn--sm staff-btn--ghost" href="/staff/pos/workstations/">View devices</a>\n              <span class="grocery-setup__status">Not started</span>\n            </div>\n            \n            <details class="grocery-setup__more">\n              <summary>Problem with this step?</summary>\n              <form method="post" action="/console/org/setup/step-state/">\n                <input type="hidden" name="csrfmiddlewaretoken" value="cYOjgO5c7vBGzs4coFMlYSmHbS6YonuQdxvhQO7C3GgsQ6h6tGpm6VdrZRUQyI3L">\n                <input type="hidden" name="step_key" value="first_workstation">\n                <input type="hidden" name="next" value="/console/org/setup/">\n                <button name="state" value="blocked" type="submit">Mark as blocked</button>\n                <button name="state" value="" type="submit">Clear blocked flag</button>\n              </form>\n            </details>\n            \n        </article>\n      \n      \n        <section class="fizo-optional" aria-labelledby="fizo-optional-title">\n          <div class="grocery-setup__section-head"><h2 id="fizo-optional-title">Useful extras</h2><span>Optional \xc2\xb7 complete when ready</span></div>\n          <div class="fizo-optional__grid">\n            \n              <article class="staff-card fizo-optional__card">\n                <div class="fizo-optional__head">\n                  <span class="fizo-optional__icon" aria-hidden="true"><i class="bi bi-person-plus"></i></span>\n                  <span class="grocery-setup__status">Optional</span>\n                </div>\n                <h3>Invite your first teammate</h3>\n                <p>Send an invite so day-to-day operations are not tied to one owner account.</p>\n                <div class="fizo-optional__actions">\n                  <a class="staff-btn staff-btn--primary" href="/staff/settings/invites/new/">Invite teammate <i class="bi bi-arrow-right" aria-hidden="true"></i></a>\n                  \n                </div>\n                <details class="grocery-setup__more">\n                  <summary>Other options</summary>\n                  <form method="post" action="/console/org/setup/step-state/"><input type="hidden" name="csrfmiddlewaretoken" value="cYOjgO5c7vBGzs4coFMlYSmHbS6YonuQdxvhQO7C3GgsQ6h6tGpm6VdrZRUQyI3L">\n                    <input type="hidden" name="step_key" value="first_team_invite"><input type="hidden" name="next" value="/console/org/setup/">\n                    <button type="submit" name="state" value="skipped">Skip for now</button>\n                    \n                  </form>\n                </details>\n              </article>\n            \n              <article class="staff-card fizo-optional__card">\n                <div class="fizo-optional__head">\n                  <span class="fizo-optional__icon" aria-hidden="true"><i class="bi bi-check2-square"></i></span>\n                  <span class="grocery-setup__status">Optional</span>\n                </div>\n                <h3>Complete a purchasing receive cycle</h3>\n                <p>Mark at least one purchase order as partially or fully received.</p>\n                <div class="fizo-optional__actions">\n                  <a class="staff-btn staff-btn--primary" href="/staff/purchasing/purchase-orders/">Open purchase orders <i class="bi bi-arrow-right" aria-hidden="true"></i></a>\n                  \n                </div>\n                <details class="grocery-setup__more">\n                  <summary>Other options</summary>\n                  <form method="post" action="/console/org/setup/step-state/"><input type="hidden" name="csrfmiddlewaretoken" value="cYOjgO5c7vBGzs4coFMlYSmHbS6YonuQdxvhQO7C3GgsQ6h6tGpm6VdrZRUQyI3L">\n                    <input type="hidden" name="step_key" value="first_po_received"><input type="hidden" name="next" value="/console/org/setup/">\n                    <button type="submit" name="state" value="skipped">Skip for now</button>\n                    \n                  </form>\n                </details>\n              </article>\n            \n              <article class="staff-card fizo-optional__card">\n                <div class="fizo-optional__head">\n                  <span class="fizo-optional__icon" aria-hidden="true"><i class="bi bi-check2-square"></i></span>\n                  <span class="grocery-setup__status">Optional</span>\n                </div>\n                <h3>Check the actual equipment</h3>\n                <p>Use the device test page and record a real print or scanner observation. A label alone is not proof.</p>\n                <div class="fizo-optional__actions">\n                  <a class="staff-btn staff-btn--primary" href="/staff/pos/workstations/">Open equipment checks <i class="bi bi-arrow-right" aria-hidden="true"></i></a>\n                  \n                </div>\n                <details class="grocery-setup__more">\n                  <summary>Other options</summary>\n                  <form method="post" action="/console/org/setup/step-state/"><input type="hidden" name="csrfmiddlewaretoken" value="cYOjgO5c7vBGzs4coFMlYSmHbS6YonuQdxvhQO7C3GgsQ6h6tGpm6VdrZRUQyI3L">\n                    <input type="hidden" name="step_key" value="device_test"><input type="hidden" name="next" value="/console/org/setup/">\n                    <button type="submit" name="state" value="skipped">Skip for now</button>\n                    \n                  </form>\n                </details>\n              </article>\n            \n              <article class="staff-card fizo-optional__card">\n                <div class="fizo-optional__head">\n                  <span class="fizo-optional__icon" aria-hidden="true"><i class="bi bi-check2-square"></i></span>\n                  <span class="grocery-setup__status">Optional</span>\n                </div>\n                <h3>Practice checkout totals safely</h3>\n                <p>Preview a product&#x27;s section price and tax without placing an order, taking money or changing stock.</p>\n                <div class="fizo-optional__actions">\n                  <a class="staff-btn staff-btn--primary" href="/console/org/setup/practice-sale/">Practice checkout <i class="bi bi-arrow-right" aria-hidden="true"></i></a>\n                  \n                </div>\n                <details class="grocery-setup__more">\n                  <summary>Other options</summary>\n                  <form method="post" action="/console/org/setup/step-state/"><input type="hidden" name="csrfmiddlewaretoken" value="cYOjgO5c7vBGzs4coFMlYSmHbS6YonuQdxvhQO7C3GgsQ6h6tGpm6VdrZRUQyI3L">\n                    <input type="hidden" name="step_key" value="practice_sale"><input type="hidden" name="next" value="/console/org/setup/">\n                    <button type="submit" name="state" value="skipped">Skip for now</button>\n                    \n                  </form>\n                </details>\n              </article>\n            \n              <article class="staff-card fizo-optional__card">\n                <div class="fizo-optional__head">\n                  <span class="fizo-optional__icon" aria-hidden="true"><i class="bi bi-check2-square"></i></span>\n                  <span class="grocery-setup__status">Optional</span>\n                </div>\n                <h3>Review your first actual sale</h3>\n                <p>After opening, inspect a real paid sale and its receipt. Setup never creates a fake financial transaction.</p>\n                <div class="fizo-optional__actions">\n                  <a class="staff-btn staff-btn--primary" href="/staff/orders/">Open orders <i class="bi bi-arrow-right" aria-hidden="true"></i></a>\n                  \n                </div>\n                <details class="grocery-setup__more">\n                  <summary>Other options</summary>\n                  <form method="post" action="/console/org/setup/step-state/"><input type="hidden" name="csrfmiddlewaretoken" value="cYOjgO5c7vBGzs4coFMlYSmHbS6YonuQdxvhQO7C3GgsQ6h6tGpm6VdrZRUQyI3L">\n                    <input type="hidden" name="step_key" value="first_paid_order"><input type="hidden" name="next" value="/console/org/setup/">\n                    <button type="submit" name="state" value="skipped">Skip for now</button>\n                    \n                  </form>\n                </details>\n              </article>\n            \n          </div>\n        </section>\n      \n    </div>\n    <aside class="grocery-setup__aside" aria-label="Business setup help">\n      <section class="staff-card">\n        <h2><i class="bi bi-check2-square text-success"></i> Before your first sale</h2>\n        <p>These automatic checks help you spot missing setup. Confirm your hardware and payments in person before using the live till.</p>\n        <ul class="grocery-setup__checks">\n          \n            <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i><span>Business type selected</span></li>\n          \n            <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i><span>Active section exists</span></li>\n          \n            <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i><span>At least one active sellable (item or service)</span></li>\n          \n            <li><i class="bi bi-circle" aria-hidden="true"></i><span>Named workstation configured \xe2\x80\x94 <a href="/staff/pos/workstations/">Fix this</a></span></li>\n          \n            <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i><span>Ready for first sale (staff and payment provider checks still required)</span></li>\n          \n        </ul>\n        \n      </section>\n      <section class="staff-card grocery-setup__profile" id="business-profile-heading" aria-label="Business profile">\n        <details >\n          <summary><i class="bi bi-sliders2" aria-hidden="true"></i> Change business type</summary>\n          <p class="mt-2">Only choose what this business sells. Changing these settings also changes which pages your staff can access.</p>\n          \n\n          <form method="post"><input type="hidden" name="csrfmiddlewaretoken" value="cYOjgO5c7vBGzs4coFMlYSmHbS6YonuQdxvhQO7C3GgsQ6h6tGpm6VdrZRUQyI3L">\n            <div class="staff-checklist"><div id="id_business_lines" class="staff-checklist"><div>\n    <label for="id_business_lines_0"><input type="checkbox" name="business_lines" value="bar" class="staff-checklist" id="id_business_lines_0">\n Bar</label>\n\n</div><div>\n    <label for="id_business_lines_1"><input type="checkbox" name="business_lines" value="lounge" class="staff-checklist" id="id_business_lines_1">\n Lounge</label>\n\n</div><div>\n    <label for="id_business_lines_2"><input type="checkbox" name="business_lines" value="restaurant" class="staff-checklist" id="id_business_lines_2">\n Restaurant</label>\n\n</div><div>\n    <label for="id_business_lines_3"><input type="checkbox" name="business_lines" value="cafeteria" class="staff-checklist" id="id_business_lines_3">\n Cafeteria</label>\n\n</div><div>\n    <label for="id_business_lines_4"><input type="checkbox" name="business_lines" value="kitchen" class="staff-checklist" id="id_business_lines_4">\n Kitchen / food preparation</label>\n\n</div><div>\n    <label for="id_business_lines_5"><input type="checkbox" name="business_lines" value="lodging" class="staff-checklist" id="id_business_lines_5">\n Lodging</label>\n\n</div><div>\n    <label for="id_business_lines_6"><input type="checkbox" name="business_lines" value="retail" class="staff-checklist" id="id_business_lines_6">\n Retail / shop</label>\n\n</div><div>\n    <label for="id_business_lines_7"><input type="checkbox" name="business_lines" value="supermarket" class="staff-checklist" id="id_business_lines_7" checked>\n Supermarket / grocery</label>\n\n</div><div>\n    <label for="id_business_lines_8"><input type="checkbox" name="business_lines" value="events" class="staff-checklist" id="id_business_lines_8">\n Events / event space</label>\n\n</div><div>\n    <label for="id_business_lines_9"><input type="checkbox" name="business_lines" value="services" class="staff-checklist" id="id_business_lines_9">\n Services / spa / appointments</label>\n\n</div>\n</div></div>\n            <p>Only the selected areas and their related setup, navigation, cards, and pages are shown.</p>\n            <button class="staff-btn staff-btn--primary" type="submit">Save business type</button>\n     