t count and accept this exact float.</p>\\n          {% if can_accept_handover %}\\n          <form method="post" class="staff-register-form">{% csrf_token %}<input type="hidden" name="action" value="accept_handover"><input type="hidden" name="handover_id" value="{{ pending_handover.pk }}">\\n            <div><label for="{{ open_form.opening_cash.id_for_label }}">Counted opening float ({{ shift_currency }})</label>{{ open_form.opening_cash }}{{ open_form.opening_cash.errors }}</div>\\n            <button class="staff-btn staff-btn--primary" type="submit">Accept and open my shift</button>\\n          </form>\\n          {% endif %}\\n        {% endif %}\\n      </section>\\n    {% endif %}\\n    {% if other_open_shifts %}\\n      <div class="fizo-register__panel"><h2 class="staff-card__title">Other open registers in {{ current_outlet.name }}</h2>\\n      <p class="staff-muted">Select a workstation to reconcile that device. Close a section-wide or legacy shift before starting additional tills.</p>\\n      <ul>{% for shift in other_open_shifts %}<li>{{ shift.workstation.name|default:"Section register" }} \xb7 opened {{ shift.opened_at }}{% if not shift.cash_attribution %} \xb7 legacy cash calculation{% endif %}</li>{% endfor %}</ul>\\n      <a class="staff-btn staff-btn--secondary" href="{% url \\'staff-workstations\\' %}">Choose workstation</a></div>\\n    {% endif %}\\n    {% if recent_shifts %}\\n      <section class="fizo-register__panel fizo-register__history" aria-labelledby="recent-shifts-title"><h2 class="staff-section-title" id="recent-shifts-title">Recent shifts</h2>\\n      <div class="fizo-register__tablewrap">\\n        <table class="fizo-register__table">\\n          <thead><tr><th>Workstation</th><th>Opened</th><th>Closed</th><th>Status</th><th>Expected</th><th>Counted</th><th>Difference</th></tr></thead>\\n          <tbody>\\n            {% for s in recent_shifts %}\\n              <tr>\\n                <td>{{ s.workstation.name|default:"Section regist