rch]\');\n    var scan=document.querySelector(\'[data-retail-scan-form] input[name="code"]\');\n    if(basket) basket.id=\'fizo-current-basket\';\n    if(search){ search.id=\'fizo-pos-menu-search\'; search.setAttribute(\'aria-label\',\'Find product by name, barcode or SKU\'); }\n    function activate(selector,input){\n      var link=document.querySelector(selector);\n      if(!link)return;\n      link.addEventListener(\'click\',function(e){\n        if(!input)return;\n        e.preventDefault();input.focus();input.select();\n        if(catalog && input===search)catalog.scrollIntoView({behavior:\'smooth\',block:\'start\'});\n      });\n    }\n    activate(\'[data-fizo-focus-search]\',search);\n    activate(\'[data-fizo-focus-scan]\',scan);\n    document.addEventListener(\'keydown\',function(e){\n      if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()===\'k\'&&search){e.preventDefault();search.focus();search.select();}\n    });\n  }\n  if(document.readyState===\'loading\')document.addEventListener(\'DOMContentLoaded\',start);else start();\n})();\n</script>\n\n\n  \n  <script defer src="/static/staff/retail-counter-v2.js?v=20261023.15"></script>\n  \n    <script id="staff-pos-menu-modifiers" type="application/json">{}</script>\n    <script>\n      (function () {\n        var dataEl = document.getElementById("staff-pos-menu-modifiers");\n        var sel = document.getElementById("staff-pos-add-line-menu-item");\n        var host = document.getElementById("staff-pos-add-line-modifiers");\n        if (!dataEl || !sel || !host) return;\n        var map = {};\n        try {\n          map = JSON.parse(dataEl.textContent) || {};\n        } catch (e) {\n          return;\n        }\n        function render() {\n          host.innerHTML = "";\n          var id = sel.value || "";\n          var groups = map[id] || [];\n          if (!groups.length) return;\n          for (var gi = 0; gi < groups.length; gi++) {\n            var g = groups[gi];\n            var wrap = document.createElement("div");\n            wrap.className = "mb-2";\n            var cap = document.createElement("div");\n            cap.className = "staff-label small mb-1";\n            var hint = g.name;\n            if (g.min > 0) {\n              hint += " (choose at least " + g.min + ")";\n            }\n            if (g.max != null) {\n              hint += " \xc2\xb7 max " + g.max;\n            }\n            cap.textContent = hint;\n            wrap.appendChild(cap);\n            var opts = g.options || [];\n            for (var oi = 0; oi < opts.length; oi++) {\n              var o = opts[oi];\n              var lab = document.createElement("label");\n              lab.className = "staff-muted d-block small mb-1";\n              var inp = document.createElement("input");\n              inp.type = "checkbox";\n              inp.name = "modifier_option";\n              inp.value = o.id;\n              inp.className = "me-1";\n              lab.appendChild(inp);\n              var extra = o.name;\n              if (o.price_delta && o.price_delta !== "0.00") {\n                extra += " (+" + o.price_delta + ")";\n              }\n              lab.appendChild(document.createTextNode(extra));\n              wrap.appendChild(lab);\n            }\n            host.appendChild(wrap);\n          }\n        }\n        sel.addEventListener("change", render);\n        render();\n      })();\n    </script>\n    <script>\n      (function () {\n        var browser = document.querySelector("[data-pos-menu-browser]");\n        var select = document.getElementById("staff-pos-add-line-menu-item");\n        if (!browser || !select) return;\n        var search = browser.querySelector("[data-pos-menu-search]");\n        var tiles = Array.prototype.slice.call(browser.querySelectorAll("[data-pos-menu-tile]"));\n        var filters = Array.prototype.slice.call(browser.querySelectorAll("[data-pos-menu-filter]"));\n        var empty = browser.querySelector("[data-pos-menu-empty]");\n        var announcement = browser.querySelector("[data-pos-menu-selection]");\n        var activeCategory = "all";\n        var quickPicks = browser.querySelector("[data-fizo-favourites]");\n        if (quickPicks) {\n          var ranked = tiles.filter(function (tile) { return tile.dataset.fizoQuickPick === "1"; });\n          if (ranked.length) {\n            quickPicks.textContent = "";\n            ranked.forEach(function (tile) {\n              var shortcut = document.createElement("button");\n              shortcut.type = "button";\n              shortcut.className = "fizo-pos-quick-pick";\n              shortcut.textContent = tile.querySelector(".staff-pos-menu-tile__name").textContent;\n              shortcut.addEventListener("click", function () {\n                activeCategory = "all";\n                filters.forEach(function (filter) {\n                  var active = filter.dataset.posMenuFilter === "all";\n                  filter.classList.toggle("is-active", active);\n                  filter.setAttribute("aria-pressed", active ? "true" : "false");\n                });\n                if (search) search.value = "";\n                updateTiles();\n                tile.click();\n              });\n              quickPicks.appendChild(shortcut);\n            });\n          }\n        }\n\n        var pageSize = browser.querySelector("[data-fizo-page-controls]") ? 40 : Infinity;\n        var pageLimit = pageSize;\n        var moreControls = browser.querySelector("[data-fizo-page-controls]");\n        var moreButton = browser.querySelector("[data-fizo-load-more]");\n        var visibleLabel = browser.querySelector("[data-fizo-visible-count]");\n        function updateTiles() {\n          var query = (search && search.value || "").trim().toLowerCase();\n          var found = 0, visibleCount = 0;\n          tiles.forEach(function (tile) {\n            var matchesCategory = activeCategory === "all" || tile.dataset.categoryId === activeCategory;\n            var matchesSearch = !query || [tile.dataset.itemName, tile.dataset.itemSku, tile.dataset.itemBarcode].some(function (value) { return (value || "").indexOf(query) !== -1; });\n            var match = matchesCategory && matchesSearch;\n            if (match) found += 1;\n            var shown = match && visibleCount < pageLimit;\n            tile.hidden = !shown;\n            if (shown) visibleCount += 1;\n          });\n          if (empty) empty.hidden = found !== 0;\n          if (moreControls) {\n            moreControls.hidden = found <= pageSize;\n            if (visibleLabel) visibleLabel.textContent = "Showing " + visibleCount + " of " + found + " matching products";\n            if (moreButton) moreButton.hidden = visibleCount >= found;\n          }\n        }\n        if (moreButton) moreButton.addEventListener("click", function () {\n          pageLimit += pageSize;\n          updateTiles();\n        });\n\n        filters.forEach(function (filter) {\n          filter.addEventListener("click", function () {\n            activeCategory = filter.dataset.posMenuFilter || "all";\n            pageLimit = pageSize;\n            filters.forEach(function (other) {\n              var active = other === filter;\n              other.classList.toggle("is-active", active);\n              other.setAttribute("aria-pressed", active ? "true" : "false");\n            });\n            updateTiles();\n          });\n        });\n        if (search) search.addEventListener("input", function () { pageLimit = pageSize; updateTiles(); });\n        var clearSearch = browser.querySelector("[data-fizo-search-clear]");\n        if (clearSearch && search) clearSearch.addEventListener("click", function () {\n          search.value = "";\n          search.focus();\n          updateTiles();\n        });\n\n        tiles.forEach(function (tile) {\n          tile.addEventListener("click", function () {\n            var itemId = tile.dataset.itemId || "";\n            select.value = itemId;\n            select.dispatchEvent(new Event("change", { bubbles: true }));\n            tiles.forEach(function (other) {\n              var active = other === tile;\n              other.classList.toggle("is-selected", active);\n              other.setAttribute("aria-pressed", active ? "true" : "false");\n            });\n            var option = select.options[select.selectedIndex];\n            if (announcement && option) announcement.textContent = option.text + " selected. Set quantity and add it to the order.";\n          });\n        });\n        select.addEventListener("change", function () {\n          var selected = tiles.find(function (tile) { return tile.dataset.itemId === select.value; });\n          tiles.forEach(function (tile) {\n            var active = tile === selected;\n            tile.classList.toggle("is-selected", active);\n            tile.setAttribute("aria-pressed", active ? "true" : "false");\n          });\n        });\n        updateTiles();\n      })();\n    </script>\n  \n\n<script src="/static/staff/grocery-checkout.js?v=20261022.2" defer></script>\n<script>\n/* Manual selection never submits a sale. Only the explicit Add button does.\n   Barcode submission continues through the dedicated scanner form. */\n</script>\n\n<script>\n(function () {\n  "use strict";\n  var form = document.querySelector("[data-retail-scan-form]");\n  if (form) {\n    var input = form.querySelector(\'input[name="code"]\');\n    var quantity = form.querySelector(\'input[name="quantity"]\');\n    var button = form.querySelector("[data-retail-scan-submit]");\n    var status = document.querySelector("[data-retail-scan-status]");\n    if (input && button) {\n      input.setAttribute("aria-label", "Barcode or product lookup code");\n      input.setAttribute("enterkeyhint", "done");\n      // Header search owns initial focus on desktop; never focus a hidden scanner.\n      document.addEventListener("keydown", function (event) {\n        if (event.key !== "/" || event.ctrlKey || event.altKey || event.metaKey || event.repeat) return;\n        var target = event.target;\n        if (target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;\n        event.preventDefault();\n        var top = document.getElementById("reference-top-catalogue-search");\n        if(top){top.focus();top.select();}else{input.focus();input.select();}\n      });\n      var submitted = false;\n      form.addEventListener("submit", function (event) {\n        if (submitted) { event.preventDefault(); return; }\n        if (!input.value.trim()) {\n          event.preventDefault();\n          input.focus();\n          if (status) status.textContent = "Scan a barcode or type a PLU first.";\n          return;\n        }\n        var qty = quantity ? Number(quantity.value) : 1;\n        if (!Number.isFinite(qty) || qty <= 0 || Math.round(qty * 1000) !== qty * 1000) {\n          event.preventDefault();\n          if (quantity) quantity.focus();\n          if (status) status.textContent = "Enter a positive quantity with at most three decimal places.";\n          return;\n        }\n        submitted = true;\n        button.disabled = true;\n        if (status) status.textContent = "Adding item to basket\xe2\x80\xa6";\n      });\n    }\n  }\n  var paymentSubmitForm = document.querySelector("[data-pos-payment-form]");\n  if (paymentSubmitForm) {\n    var paymentPending = false;\n    paymentSubmitForm.addEventListener("submit", function (event) {\n      if (paymentPending) { event.preventDefault(); return; }\n      if (!paymentSubmitForm.checkValidity()) return;\n      paymentPending = true;\n      var submitButton = paymentSubmitForm.querySelector(\'button[type="submit"]\');\n      if (submitButton) {\n        submitButton.disabled = true;\n        submitButton.textContent = "Recording payment\xe2\x80\xa6";\n      }\n    });\n  }\n  var cashPanel = document.querySelector("[data-retail-cash-panel]");\n  if (cashPanel) {\n    var received = cashPanel.querySelector("[data-retail-cash-received]");\n    var change = cashPanel.querySelector("[data-retail-change]");\n    var tenderStatus = cashPanel.querySelector("[data-retail-tender-status]");\n    var paymentAction = document.querySelector(\'form input[name="action"][value="record_payment"]\');\n    var paymentForm = paymentAction && paymentAction.form;\n    var paymentAmount = paymentForm && paymentForm.querySelector(\'input[name="amount"]\');\n    var paymentMethod = paymentForm && paymentForm.querySelector(\'select[name="method"]\');\n    var dueRaw = Number(cashPanel.getAttribute("data-balance-due"));\n    var dueCents = Math.round(dueRaw * 100);\n    function calculateChange() {\n      var raw = received.value.trim();\n      var tender = raw === "" ? NaN : Number(raw);\n      var cents = Math.round(tender * 100);\n      change.textContent = "\xe2\x80\x94";\n      if (!Number.isFinite(dueRaw) || !Number.isFinite(tender) || tender < 0 ||\n          !Number.isSafeInteger(cents) || Math.abs(tender * 100 - cents) > 0.000001) {\n        tenderStatus.textContent = "Enter a valid cash amount with at most two decimal places.";\n        return;\n      }\n      if (cents < dueCents) {\n        tenderStatus.textContent = "Cash is less than the amount due. Use the payment form for a partial payment.";\n        return;\n      }\n      change.textContent = ((cents - dueCents) / 100).toFixed(2);\n      tenderStatus.textContent = "Change shown above. Record the due amount, not the cash tendered.";\n      if (paymentAmount && paymentMethod && paymentMethod.value === "cash") {\n        paymentAmount.value = (dueCents / 100).toFixed(2);\n      }\n    }\n    received.addEventListener("input", calculateChange);\n    if (paymentMethod) paymentMethod.addEventListener("change", calculateChange);\n  }\n})();\n</script>\n\n<script>\n/* Shortcuts only select an allowed method and focus the existing payment form.\n   They never record a payment without the cashier\'s normal form submission. */\ndocument.addEventListener("click", function(event) {\n  var button = event.target.closest("[data-fizo-payment-method]");\n  if (!button) return;\n  var form = document.querySelector("[data-pos-payment-form]");\n  var method = form && form.querySelector(\'select[name="method"]\');\n  var amount = form && form.querySelector(\'input[name="amount"]\');\n  if (!method) return;\n  var choice = button.getAttribute("data-fizo-payment-method");\n  if (!Array.from(method.options).some(function(opt) { return opt.value === choice; })) return;\n  method.value = choice;\n  method.dispatchEvent(new Event("change", {bubbles:true}));\n  document.querySelectorAll("[data-fizo-payment-method]").forEach(function(candidate) {\n    candidate.setAttribute("aria-pressed", candidate === button ? "true" : "false");\n  });\n  if (amount) { amount.focus(); amount.select(); }\n});\n\n/* Quantity steppers submit the existing authenticated stock-adjustment form. */\ndocument.addEventListener("click", function (event) {\n  var button = event.target.closest("[data-fizo-step]");\n  if (!button) return;\n  var form = button.closest("[data-fizo-qty-form]");\n  if (!form || form.dataset.submitting === "1") return;\n  var input = form.querySelector(\'input[name="quantity"]\');\n  if (!input) return;\n  var current = Number(input.value), delta = Number(button.dataset.fizoStep);\n  if (!Number.isFinite(current) || !Number.isFinite(delta)) return;\n  var next = Math.round((current + delta) * 1000) / 1000;\n  if (next < 0.001) return;\n  input.value = String(next);\n  form.dataset.submitting = "1";\n  if (form.requestSubmit) form.requestSubmit(); else form.submit();\n});\n\n/* Retail-only composition; existing POST forms still own all stock and payment rules. */\n(function () {\n  function initializeRetailWorkspace() {\n    var catalogue = document.querySelector(".fizo-checkout-catalogue");\n    var basket = document.querySelector(".fizo-checkout-basket");\n    var scanner = document.querySelector("#retail-fast-checkout");\n    if (!catalogue || !basket) return;\n    // Brand and search already live in the actual cashier header; no duplicate heading.\n    if (scanner) {\n      catalogue.insertBefore(scanner, catalogue.firstChild);\n      scanner.classList.add("fizo-retail-pos-scanner");\n      scanner.querySelectorAll("input").forEach(function (input) {\n        if (input.type === "text" || input.type === "search") {\n          input.setAttribute("placeholder", "Scan barcode or enter product code");\n          input.setAttribute("autocomplete", "off");\n        }\n      });\n    }\n    var quickForm = document.querySelector("#fizo-quick-product");\n    if (quickForm) {\n      if (scanner) scanner.insertAdjacentElement("afterend", quickForm);\n      else catalogue.insertBefore(quickForm, catalogue.firstChild);\n      var quickSubmit = quickForm.querySelector(\'form[data-fizo-quick-product-form]\');\n      if (quickSubmit) quickSubmit.addEventListener("submit", function (event) {\n        if (quickSubmit.dataset.submitted === "1") { event.preventDefault(); return; }\n        if (!quickSubmit.checkValidity()) return;\n        quickSubmit.dataset.submitted = "1";\n        var button = quickSubmit.querySelector(\'button[type="submit"]\');\n        if (button) { button.disabled = true; button.textContent = "Adding product\xe2\x80\xa6"; }\n      });\n    }\n    // F3 is handled by retail-counter-v2.js through the visible header.\n    var cards = catalogue.querySelectorAll("[data-pos-menu-tile]");\n    cards.forEach(function (tile) {\n      tile.setAttribute("title", "Select " + (tile.dataset.itemName || "product") + " and add to basket");\n    });\n  }\n  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initializeRetailWorkspace);\n  else initializeRetailWorkspace();\n})();\n</script>\n\n  \n    <script>\n      (function () {\n        function broadcast() { try { localStorage.setItem(\'staff-terminal-lock\', String(Date.now())); } catch (e) {} }\n        document.querySelectorAll(\'form[action="/staff/terminal/lock/"]\').forEach(function (form) {\n          form.addEventListener(\'submit\', broadcast);\n        });\n        window.addEventListener(\'storage\', function (event) {\n          if (event.key === \'staff-terminal-lock\') window.location.replace(\'/staff/terminal/\');\n        });\n        window.staffBroadcastTerminalLock = broadcast;\n      }());\n    </script>\n  \n  \n</body>\n</html>\n'
