le</button></form>\n    </div>\n  {% endif %}\n  {% if can_record_payment and payment_form %}\n    <section class="staff-card" aria-label="Cash tender calculator" data-retail-cash-panel data-balance-due="{{ balance_due }}">\n      <h2 class="staff-card__title">Cash payment � calculate change</h2>\n      <p class="staff-muted small">Enter what the shopper hands you to see their change. To complete payment, use <strong>Pay</strong> and select <strong>Cash</strong>. The cash-received figure is not the sale amount.</p>\n      <div class="row g-2 align-items-end">\n        <div class="col-12 col-sm-6"><label class="staff-label" for="retail-cash-received">Cash received ({{ order.currency }})</label><input id="retail-cash-received" class="staff-input" type="number" min="0" step="0.01" inputmode="decimal" data-retail-cash-received></div>\n        <div class="col-12 col-sm-6"><span class="staff-label">Change to return</span><output class="d-block fw-bold" for="retail-cash-received" data-retail-change>�</output></div>\n      </div>\n      <p class="staff-muted small mt-2 mb-0" role="status" aria-live="polite" data-retail-tender-status>Enter the cash handed over to calculate change.</p>\n    </section>\n  {% endif %}\n  {% if order.is_paid and order.status == \'closed\' %}\n  <section class="staff-card mb-3" aria-label="Paid order pickup">\n    <h2 class="staff-card__title">Paid sale � collection or pickup</h2>\n    <p class="staff-muted small">A confirmed pickup records the handover of goods already sold. It does not reserve unpaid stock, issue a deposit refund or change inventory twice.</p>\n    {% if retail_pickup %}\n      <p><strong>{{ retail_pickup.get_status_display }}</strong> � Expected {{ retail_pickup.expected_on }}\n      {% if retail_pickup.collected_at %} � Collected {{ retail_pickup.collected_at }} by {{ retail_pickup.collected_by.email|default:"Former worker" }}{% endif %}</p>\n      {% if retail_pickup.status == \'awaiting\' and can_modify_open_order == False %}\n      <form method="post" class="row g-2">{% csrf_token %}\n        <input type="hidden" name="action" value="hand_over_paid_pickup">\n        <div class="col-12 col-lg-9"><label class="staff-label" for="pickup-proof">Customer identity and physical handover confirmation</label>\n          <textarea class="staff-input" id="pickup-proof" name="note" required minlength="12" maxlength="300" rows="2"></textarea></div>\n        <div class="col-12 col-lg-3 align-self-end"><button class="staff-btn staff-btn--primary" type="submit">Confirm collected</button></div></form>{% endif %}\n    {% elif can_schedule_paid_pickup %}\n      <form method="post" class="row g-2 align-items-end">{% csrf_token %}\n        <input type="hidden" name="action" value="schedule_paid_pickup">\n        <div class="col-12 col-md-4"><label class="staff-label" for="pickup-when">Expected collection date</label>\n          <input class="staff-input" type="date" id="pickup-when" name="expected_on" required></div>\n        <div class="col-12 col-md-5"><label class="staff-label" for="pickup-note">Collection note</label>\n          <input class="staff-input" id="pickup-note" name="note" maxlength="300" placeholder="Collection shelf or pickup instructions"></div>\n        <div class="col-12 col-md-3"><button type="submit" class="staff-btn staff-btn--primary">Schedule pickup</button></div></form>\n    {% else %}<p class="staff-muted">An identified customer and manager approval are required to schedule collection.</p>{% endif %}\n    <a class="staff-btn staff-btn--ghost mt-2" href="{% url \'staff-retail-pickups\' %}">See pickup queue</a>\n  </section>{% endif %}\n  <section class="staff-card mb-3" aria-label="Wholesale prices">\n    <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">\n      <div><h2 class="staff-card__title">Wholesale quantity pricing</h2>\n      <p class="staff-muted small">Only for identified customers and authorized managers. Regular walk-in shoppers keep shelf prices. Never combined with an order promotion.</p></div>\n      <a class="staff-btn staff-btn--ghost" href="{% url \'staff-wholesale-pricing\' %}">Manage tiers</a>\n    </div>\n    {% if can_apply_wholesale %}\n    <form method="post" class="row g-2 align-items-end">{% csrf_token %}\n      <input type="hidden" name="action" value="apply_wholesale">\n      <div class="col-12 col-md-8"><label class="staff-label" for="wholesale-line">Eligible order item</label>\n      <select name="line_id" id="wholesale-line" class="staff-input" required>\n        <option value="">Select eligible line</option>\n        {% for line, rule in wholesale_available_lines %}{% if rule %}\n        <option value="{{ line.id }}">{{ line.label }} � {{ line.quantity }} units � {{ order.currency }} {{ rule.unit_price }} per unit (from {{ rule.minimum_quantity }})</option>\n        {% endif %}{% endfor %}\n      </select></div>\n      <div class="col-12 col-md-4"><button type="submit" class="staff-btn staff-btn--primary staff-btn--touch">Manager: apply wholesale price</button></div>\n    </form>\n    {% else %}<p class="staff-muted">Link the customer\'s verified profile before recording payment to enable wholesale approval. Manager rights required.</p>{% endif %}\n  </section>\n  {% if can_modify_open_order and line_discount_form %}\n    <div class="staff-card">\n      <h2 class="staff-card__title">Line discount</h2>\n      <p class="staff-muted">Choose the item to discount, then enter an amount or percent.</p>\n      {% include "staff/includes/form_errors_block.html" with form=line_discount_form title="Fix discount details" %}\n      <form method="post" class="row g-2 align-items-end">\n        {% csrf_token %}\n        <input type="hidden" name="action" value="line_discount">\n        <div class="col-md-3">\n          <label class="staff-label" for="disc_line">Order item</label>\n          <select class="staff-input" id="disc_line" name="line_id" required>\n            <option value="">Select 