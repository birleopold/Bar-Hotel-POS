 %}No workstation selected{% endif %} \xb7 Sale {{ order.bill_reference }}</small></span></div>\\n  <a class="reference-customer-display-link" href="{% url \\'staff-retail-customer-display\\' order_id=order.id %}" target="_blank" rel="noopener" title="Open read-only customer-facing display on a second monitor"><i class="bi bi-display" aria-hidden="true"></i><span>Customer screen</span></a>\\n  <a class="staff-btn staff-btn--ghost reference-register-settings" href="{% url \\'staff-workstations\\' %}">Register settings</a>\\n</section>\\n  {% endif %}\\n  <h1 class="visually-hidden">{% if is_supermarket_outlet %}Sale{% else %}Order{% endif %} {{ order.bill_reference }}</h1>\\n  <div class="staff-pos-totals-row">\\n    <span class="staff-pos-totals-row__total">{{ order.currency }} <strong>{{ order.total }}</strong></span>\\n    <span class="staff-pos-totals-row__meta">Sub {{ order.subtotal }} \xb7 Tax {{ order.tax_total }}</span>\\n    {% if order.applied_promotion %}<span class="staff-pos-totals-row__meta">Offer: {{ order.applied_promotion.name }}</span>{% endif %}\\n    {% if order.folio %}<span class="staff-pos-totals-row__meta">Folio: {{ order.folio.guest_name }}</span>{% endif %}\\n    {% if order.customer %}<span class="staff-pos-totals-row__meta">Customer: {{ order.customer.name }}</span>{% endif %}\\n  </div>\\n  {% if not is_supermarket_outlet or order.customer_id %}<details class="staff-card mb-3"><summary>Customer record{% if order.customer %} \xb7 {{ order.customer.name }}{% endif %}</summary>\\n    <p class="staff-muted mt-2">Confirm the person before linking. This changes the shared history link, not the receipt or payment.</p>\\n    <form method="post" class="staff-register-form">{% csrf_token %}<input type="hidden" name="action" value="set_customer"><label for="order-customer">Customer</label><select id="order-customer" class="staff-input" name="customer_id"><option value="">No linked customer</option>{% for person in customer_options %}<option value="{{ person.pk }}"{% if order.customer_id == person.pk %} selected{% endif %}>{{ person.name }}{% if person.phone %} \xb7 {{ person.phone }}{% endif %}</option>{% endfor %}</select><button type="submit" class="staff-btn staff-btn--secondary">Save customer link</button></form>\\n    {% if order.customer and can_view_customer_profile %}<a href="{% url \\'staff-customer-detail\\' order.customer.pk %}">View customer history</a>{% endif %}\\n    {% if loyalty_award %}\\n      <p class="staff-muted mt-2 mb-0"><strong>Customer points earned:</strong> {{ loyalty_award.points }} from this settled sale. Returns adjust those points in the customer ledger.</p>\\n    {% elif loyalty_policy_active and not order.is_paid %}\\n      {% if order.customer %}\\n        <p class="staff-muted mt-2 mb-0"><strong>Estimated reward:</strong> {{ loyalty_estimate|default_if_none:"0" }} points after full settlement, subject to the final eligible amount. No points have been posted yet.</p>\\n      {% else %}\\n        <p class="staff-muted mt-2 mb-0">Customer points are active. Link the correct customer before the final payment to qualify for earning.</p>\\n      {% endif %}\\n    {% endif %}\\n  </details>{% endif %}\\n\\n  {% if ready_handoff_count and can_ack_ready_handoff %}\\n    <div class="staff-alert staff-alert--info staff-alert--pos mb-0">{{ ready_handoff_count }} ready \u2014 ack below.</div>\\n  {% endif %}\\n\\n  {% if is_supermarket_outlet %}\\n{% if order.status == \\'open\\' and not order.is_paid and not can_modify_open_order %}\\n<div class="staff-alert staff-alert--warning fizo-cashier-blocker" role="status"><strong>Checkout is unavailable for this account.</strong> Your current role cannot add products to this sale. Ask a workspace manager to check your permissions and the selected outlet.</div>\\n{% elif can_modify_open_order and not add_line_form %}\\n<div class="staff-alert staff-alert--warning fizo-cashier-blocker" role="status"><strong>Product catalogue isn\\'t enabled for this workspace.</strong> Enable the retail/supermarket catalogue in business setup to search and sell products.</div>\\n{% elif can_modify_open_order and add_line_form and not pos_menu_categories %}\\n<div class="staff-alert staff-alert--info fizo-cashier-blocker" role="status"><strong>No products appear in this outlet.</strong> Search another product name or check that active products are assigned to {{ order.outlet.name }}.</div>\\n{% endif %}\\n \\n  {% endif %}\\n  {% if is_supermarket_outlet %}\\n  <section class="fizo-cashier-shortcuts" aria-label="Cashier tools">\\n    <div><strong>Fast checkout</strong><span>Search products, scan barcodes and collect payment from this screen.</span></div>\\n    <nav aria-label="Checkout quick actions">\\n      <a href="#fizo-pos-menu-search" data-fizo-focus-search><i class="bi bi-search" aria-hidden="true"></i> Find product <kbd>F2</kbd></a>\\n      <a href="#retail-fast-checkout" data-fizo-focus-scan><i class="bi bi-upc-scan" aria-hidden="true"></i> Barcode <kbd>F3</kbd></a>\\n      <a href="#fizo-current-basket"><i class="bi bi-basket3" aria-hidden="true"></i> Basket</a>\\n      <a href="{% url \\'staff-orders\\' %}"><i class="bi bi-clock-history" aria-hidden="true"></i> Held sales</a>\\n    </nav>\\n  </section>\\n  {% endif %}\\n  <div class="staff-pos-order-layout">\\n    {% if is_supermarket_outlet %}\\n      <section class="staff-pos-order-main fizo-checkout-catalogue" aria-label="Select products">\\n      {% include \\'staff/includes/fizo_pos_catalogue.html\\' %}\\n      </section>\\n    {% else %}\\n      <section class="fizo-hospitality-catalogue" aria-label="Menu selection">\\n        {% include \\'staff/includes/fizo_pos_catalogue.html\\' %}\\n      </section>\\n    {% endif %}\\n\\n    <aside class="staff-pos-order-side staff-pos-panel-scroll" aria-label="{% if is_supermarket_outlet %}Checkout actions{% else %}Order actions{% endif %}">\\n      {% if not is_supermarket_outlet %}\\n        <div class="fizo-hospitality-bill" aria-label="Current order">\\n          <h2><i class="bi bi-receipt" aria-hidden="true"></i> Current order <span>{{ order.bill_reference }}</span></h2>\\n    <section class="fizo-hospitality-bill__lines" aria-label="{% if is_supermarket_outlet %}Sale items{% else %}Order lines{% endif %}">\\n      <div class="staff-card staff-card--pos mb-0">\\n        <h2 class="staff-card__title staff-card__title--pos">Lines</h2>\\n        <div class="staff-table-wrap staff-table-wrap--pos">\\n          <table class="staff-table staff-table--pos">\\n            <thead>\\n              <tr>\\n                <th>Item</th>\\n                <th>Qty</th>\\n                <th>Prep</th>\\n                <th>Amt</th>\\n                <th class="staff-table__actions-head">Actions</th>\\n              </tr>\\n            </thead>\\n            <tbody>\\n              {% for line in order.lines.all %}\\n                {% if not line.is_voided %}\\n                  <tr>\\n                    <td>\\n                      {{ line.label }}{% if line.line_discount_amount %} <span class="staff-muted">(disc.)</span>{% endif %}\\n                      {% if line.modifiers_snapshot %}\\n                        <div class="staff-muted small mt-1">\\n                          {% for m in line.modifiers_snapshot %}{{ m.group }}: {{ m.name }}{% if not forloop.last %} \xb7 {% endif %}{% endfor %}\\n                        </div>\\n                      {% endif %}\\n                    </td>\\n                    <td>{{ line.quantity }}</td>\\n                    <td><span class="staff-tag staff-tag--citrus">{{ line.get_kds_status_display }}</span>{% if line.kds_station %} <span class="staff-muted">{{ line.kds_station }}</span>{% endif %}</td>\\n                    <td>{{ line.line_total }}</td>\\n                    <td class="staff-table--pos-actions staff-table__actions-cell">\\n                      {% if line.id|stringformat:"s" in ready_line_ids and can_ack_ready_handoff %}\\n                        <form method="post" class="d-inline">\\n                          {% csrf_token %}\\n                          <input type="hidden" name="action" value="ack_ready_line">\\n                          <input type="hidden" name="line_id" value="{{ line.id }}">\\n                          <button type="submit" class="staff-btn staff-btn--sm staff-btn--primary">Ack</button>\\n                        </form>\\n                      {% endif %}\\n                      {% if can_modify_open_order %}\\n                        <form method="post" class="staff-pos-line-actions">\\n                          {% csrf_token %}\\n                          <input type="hidden" name="action" value="adjust_line_qty">\\n                          <input type="hidden" name="line_id" value="{{ line.id }}">\\n                          <input class="staff-input staff-input--pos-qty" type="number" name="quantity" step="0.001" min="0.001" value="{{ line.quantity }}" aria-label="Quantity">\\n                          <button type="submit" class="staff-btn staff-btn--sm staff-btn--ghost">Set</button>\\n                        </form>\\n                        <form method="post" class="staff-pos-line-actions mt-1">\\n                          {% csrf_token %}\\n                          <input type="hidden" name="action" value="void_line">\\n                          <input type="hidden" name="line_id" value="{{ line.id }}">\\n                          <input class="staff-input staff-input--pos-reason" type="text" name="reason" placeholder="Why void" aria-label="Void reason">\\n                          <button type="submit" class="staff-btn staff-btn--sm staff-btn--ghost">Void</button>\\n                        </form>\\n                      {% endif %}\\n                    </td>\\n                  </tr>\\n                {% endif %}\\n              {% empty %}\\n                <tr><td colspan="5"><div class="staff-empty-state"><p class="staff-empty-state__title">{% if is_supermarket_outlet %}Basket empty{% else %}No order lines yet{% endif %}</p><p class="staff-empty-state__copy">{% if is_supermarket_outlet %}Scan a barcode or choose a product to start the sale.{% else %}Add items or services from the action panel to build this bill.{% endif %}</p></div></td></tr>\\n              {% endfor %}\\n            </tbody>\\n          </table>\\n        </div>\\n      </div>\\n    </section>\\n\\n\\n        </div>\\n      {% endif %}\\n      {% if is_supermarket_outlet %}\\n      <div class="fizo-checkout-basket" id="fizo-current-basket" aria-label="Current basket">\\n        <div class="fizo-cashier-payment-summary" aria-label="Sale total and payment">\\n          <span>Payable now</span><strong>{{ order.currency }} {{ balance_due }}</strong>\\n          {% if can_record_payment %}\\n          <a href="#fizo-cashier-payment" class="fizo-cashier-pay-cta"><i class="bi bi-credit-card" aria-hidden="true"></i> Take payment <i class="bi bi-arrow-right" aria-hidden="true"></i></a>\\n          {% endif %}\\n        </div>\\n        <h2 class="fizo-checkout-basket__title"><i class="bi bi-cart3" aria-hidden="true"></i> Current basket <span>{{ active_basket_line_count }} lines \xb7 {{ order.bill_reference }}</span></h2>\\n        <nav class="fizo-retail-basket-tools" aria-label="Cashier shortcuts">\\n          {% if can_modify_open_order and order.status == \\'open\\' and not order.is_paid %}\\n          <a href="#hold_label"><i class="bi bi-pause-circle" aria-hidden="true"></i> Hold Sale</a>\\n          <a href="#void_reason" class="reference-clear-basket"><i class="bi bi-trash3" aria-hidden="true"></i> Clear Basket</a>\\n          {% endif %}\\n          {% if hardware.receipt_printer_enabled %}\\n          <a href="{% url \\'staff-order-print\\' order_id=order.id %}?type=receipt&amp;format=80mm" target="_blank" rel="noopener"><i class="bi bi-printer" aria-hidden="true"></i> Print Receipt</a>\\n          {% endif %}\\n        </nav>\\n    <section class="fizo-checkout-basket__lines" aria-label="Basket items">\\n      <div class="fizo-retail-basket-items">\\n        {% for line in order.lines.all %}\\n          {% if not line.is_voided %}\\n            <article class="fizo-retail-basket-row">\\n              <div class="reference-basket-thumb">{% if line.menu_item and line.menu_item.display_image_url %}<img src="{{ line.menu_item.display_image_url }}" alt="" loading="lazy">{% else %}<i class="bi bi-bag" aria-hidden="true"></i>{% endif %}</div>\\n              <div class="fizo-retail-basket-row__info">\\n                <strong>{{ line.label }}</strong>\\n                {% if line.line_discount_amount %}<span class="staff-muted small">Discount applied</span>{% endif %}\\n                {% if line.modifiers_snapshot %}<span class="staff-muted small">{% for modifier in line.modifiers_snapshot %}{{ modifier.name }}{% if not forloop.last %}, {% endif %}{% endfor %}</span>{% endif %}\\n                <span class="reference-basket-unit">{{ order.currency }} {{ line.unit_price }}</span><span class="fizo-retail-basket-row__amount">{{ order.currency }} {{ line.line_total }}</span>\\n              </div>\\n              {% if can_modify_open_order %}\\n                <form method="post" class="fizo-retail-stepper" data-fizo-qty-form>\\n                  {% csrf_token %}\\n                  <input type="hidden" name="action" value="adjust_line_qty">\\n                  <input type="hidden" name="line_id" value="{{ line.id }}">\\n                  <button type="button" data-fizo-step="-1" aria-label="Decrease quantity of {{ line.label }}">\u2212</button>\\n                  <input type="number" name="quantity" min="{% if line.menu_item.supermarket_profile.allow_fractional_quantity %}0.001{% else %}1{% endif %}" step="{% if line.menu_item.supermarket_profile.allow_fractional_quantity %}0.001{% else %}1{% endif %}" value="{{ line.quantity }}" aria-label="Quantity of {{ line.label }}">\\n                  <button type="button" data-fizo-step="1" aria-label="Increase quantity of {{ line.label }}">+</button>\\n                  <button type="submit" class="fizo-retail-stepper__save" aria-label="Save updated quantity">Update</button>\\n                </form>\\n                <form method="post" class="fizo-retail-basket-row__void">\\n                  {% csrf_token %}\\n                  <input type="hidden" name="action" value="void_line">\\n                  <input type="hidden" name="line_id" value="{{ line.id }}">\\n                  <button type="submit" aria-label="Remove {{ line.label }} from unpaid basket"><i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden">Remove</span></button>\\n                </form>\\n              {% else %}\\n                <span class="fizo-retail-basket-row__quantity">Qty {{ line.quantity }}</span>\\n              {% endif %}\\n            </article>\\n          {% endif %}\\n        {% empty %}\\n          <div class="fizo-retail-basket-empty"><i class="bi bi-basket2"></i><p>Basket empty. Scan a barcode or select a product to begin.</p></div>\\n        {% endfor %}\\n      </div>\\n    </section>\\n    <div class="fizo-retail-basket-summary" aria-label="Sale totals">\\n      <div><span>Subtotal</span><strong>{{ order.currency }} {{ order.subtotal }}</strong></div>\\n      <div><span>Tax</span><strong>{{ order.currency }} {{ order.tax_total }}</strong></div>\\n      <div class="fizo-retail-basket-summary__total"><span>Total due</span><strong>{{ order.currency }} {{ balance_due }}</strong></div>\\n    </div>\\n      </div>\\n      {% endif %}\\n      {% if is_supermarket_outlet and not can_record_payment %}\\n        <section class="reference-payment-idle" aria-label="Payment methods">\\n          <h2>Payment</h2>\\n          <div class="fizo-retail-payment-shortcuts" role="group" aria-label="Payment methods unavailable until items added">\\n            <button type="button" disabled aria-disabled="true"><i class="bi bi-cash-stack"></i> Cash</button>\\n            <button type="button" disabled aria-disabled="true"><i class="bi bi-credit-card"></i> Card</button>\\n            <button type="button" disabled aria-disabled="true"><i class="bi bi-phone"></i> Mobile Money</button>\\n          </div>\\n          <p>Add an item to enable payment.</p>\\n        </section>\\n      {% endif %}\\n      {% if can_record_payment and payment_form %}\\n        <div class="staff-card staff-card--pos{% if is_supermarket_outlet %} reference-payment-card{% endif %}">\\n          <h2 class="staff-card__title staff-card__title--pos">Pay</h2>\\n          <p class="staff-muted small">Register: {% if settlement_station %}<strong>{{ settlement_station.name }}</strong>{% else %}Automatic when one shift is open{% endif %} \xb7 <a href="{% url \\'staff-workstations\\' %}">Choose till</a></p>\\n          <p class="staff-muted staff-pos-side-hint">Due <strong>{{ order.currency }} {{ balance_due }}</strong> \xb7 Paid {{ order.currency }} {{ amount_paid }}</p>\\n          {% include "staff/includes/form_errors_block.html" with form=payment_form title="Fix payment details" %}\\n          {% if is_supermarket_outlet %}\\n          <div class="fizo-retail-payment-shortcuts" role="group" aria-label="Choose payment method">\\n            <button type="button" data-fizo-payment-method="cash"><i class="bi bi-cash-stack"></i> Cash</button>\\n            <button type="button" data-fizo-payment-method="card"><i class="bi bi-credit-card"></i> Card</button>\\n            <button type="button" data-fizo-payment-method="mobile_money"><i class="bi bi-phone"></i> Mobile Money</button>\\n          </div>\\n          {% endif %}\\n          {% if is_supermarket_outlet %}<div id="fizo-cashier-payment" class="fizo-cashier-pay-intro"><strong>Collect payment</strong><span>Choose a method, confirm the amount, then record the payment.</span></div>{% endif %}\\n          <form method="post" class="row g-2 align-items-end" data-pos-payment-form>\\n            {% csrf_token %}\\n            <input type="hidden" name="action" value="record_payment">\\n            <input type="hidden" name="payment_request_key" value="{{ payment_request_key }}">\\n            <div class="col-12 col-md-4">{{ payment_form.amount.label_tag }}{{ payment_form.amount }}</div>\\n            <div class="col-12 col-md-4">{{ payment_form.method.label_tag }}{{ payment_form.method }}</div>\\n            <div class="col-12 col-md-4"><button type="submit" class="staff-btn staff-btn--primary staff-btn--touch">Record payment</button></div>\\n          </form>\\n        </div>\\n      {% endif %}\\n\\n      {% if can_set_folio and folio_form %}\\n        <div class="staff-card staff-card--pos">\\n          <h2 class="staff-card__title staff-card__title--pos">Folio</h2>\\n          <p class="staff-muted staff-pos-side-hint">Attach the guest folio, then collect payment here or charge the remaining balance to the room.</p>\\n          {% include "staff/includes/form_errors_block.html" with form=folio_form title="Fix folio assignment" %}\\n          <form method="post" class="row g-2 align-items-end">\\n            {% csrf_token %}\\n            <input type="hidden" name="action" value="set_folio">\\n            <div class="col-12 col-md-8">{{ folio_form.folio_id.label_tag }}{{ folio_form.folio_id }}</div>\\n            <div class="col-12 col-md-4"><button type="submit" class="staff-btn staff-btn--ghost staff-btn--touch w-100">Save</button></div>\\n          </form>\\n          {% if can_charge_to_folio %}\\n            <form method="post" class="staff-pos-folio-charge-form mt-3">\\n              {% csrf_token %}<input type="hidden" name="action" value="charge_to_folio">\\n              <p class="staff-muted mb-2">Charge {{ order.currency }} {{ balance_due }} to {{ order.folio.guest_name }}. POS payments already collected will appear as a folio credit.</p>\\n              <button type="submit" class="staff-btn staff-btn--primary staff-btn--touch">Charge balance to folio</button>\\n            </form>\\n          {% endif %}\\n        </div>\\n      {% endif %}\\n\\n      {% if can_modify_open_order and add_service_form and service_offerings %}\\n        <div class="staff-card staff-card--pos">\\n          <h2 class="staff-card__title staff-card__title--pos">Service</h2>\\n          {% include "staff/includes/form_errors_block.html" with form=add_service_form title="Fix service details" %}\\n          <form method="post" class="row g-2 align-items-end">\\n            {% csrf_token %}\\n            <input type="hidden" name="action" value="add_service_line">\\n            <div class="col-12 col-md-6">{{ add_service_form.service_offering.label_tag }}{{ add_service_form.service_offering }}</div>\\n            <div class="col-12 col-md-4">{{ add_service_form.service_option.label_tag }}{{ add_service_form.service_option }}</div>\\n            <div class="col-6 col-md-2">{{ add_service_form.quantity.label_tag }}{{ add_service_form.quantity }}</div>\\n            <div class="col-6 col-md-12 col-lg-auto d-flex align-items-end"><button type="submit" class="staff-btn staff-btn--primary staff-btn--touch">Add</button></div>\\n          </form>\\n        </div>\\n      {% endif %}\\n\\n      {% if can_modify_open_order and apply_promotion_form %}\\n        <div class="staff-card staff-card--pos">\\n          <h2 class="staff-card__title staff-card__title--pos">Offer</h2>\\n          {% include "staff/includes/form_errors_block.html" with form=apply_promotion_form title="Fix offer details" %}\\n          <form method="post" class="row g-2 align-items-end">\\n            {% csrf_token %}\\n            <input type="hidden" name="action" value="apply_promotion">\\n            <div class="col-12 col-md-8">{{ apply_promotion_form.promotion.label_tag }}{{ apply_promotion_form.promotion }}</div>\\n            <div class="col-12 col-md-4"><button type="submit" class="staff-btn staff-btn--ghost staff-btn--touch w-100">Apply</button></div>\\n          </form>\\n        </div>\\n      {% endif %}\\n\\n      {% if can_modify_open_order and order.status == \\'open\\' and not order.is_paid %}\\n        <div class="staff-card staff-card--pos">\\n          <h2 class="staff-card__title staff-card__title--pos">Hold / void</h2>\\n          <div class="row g-2" data-pos-hold-mask>\\n            <div class="col-12 col-md-6">\\n              <form method="post">\\n                {% csrf_token %}\\n                <input type="hidden" name="action" value="hold_order">\\n                <label class="staff-label" for="hold_label">Hold</label>\\n                <input class="staff-input mb-2" id="hold_label" name="hold_label" maxlength="64" placeholder="{% if is_supermarket_outlet %}Basket note (optional){% else %}Name / table{% endif %}" autocomplete="off" data-pos-hold-input>\\n                <button type="submit" class="staff-btn staff-btn--ghost staff-btn--touch" data-pos-hold-save>Hold</button>\\n              </form>\\n            </div>\\n            <div class="col-12 col-md-6">\\n              <form method="post">\\n                {% csrf_token %}\\n                <input type="hidden" name="action" value="void_order">\\n                <label class="staff-label" for="void_reason">Void all</label>\\n                <input class="staff-input mb-2" id="void_reason" name="reason" maxlength="255" placeholder="Reason" autocomplete="off">\\n                <button type="submit" class="staff-btn staff-btn--ghost staff-btn--touch">Void</button>\\n              </form>\\n            </div>\\n          </div>\\n        </div>\\n      {% endif %}\\n\\n      {% if can_record_refund and refund_form %}\\n        <div class="staff-card staff-card--pos">\\n          <h2 class="staff-card__title staff-card__title--pos">{% if is_supermarket_outlet %}Other refund{% else %}Refund{% endif %}</h2>\\n          <p class="staff-muted staff-pos-side-hint">Max {{ refundable_remaining }}</p>\\n          <p class="staff-muted small">Refunds are paid out from {% if settlement_station %}<strong>{{ settlement_station.name }}</strong>{% else %}the only open register{% endif %}. <a href="{% url \\'staff-workstations\\' %}">Choose refund till</a></p>\\n          {% if is_supermarket_outlet %}<p class="staff-muted">For returned items, use \u201cReturn and refund\u201d below to link the item, payment, and stock movement. Use this form for a price adjustment or other refund without a returned item.</p>{% endif %}\\n          {% include "staff/includes/form_errors_block.html" with form=refund_form title="Fix refund details" %}\\n          <form method="post" class="row g-2 align-items-end">\\n            {% csrf_token %}\\n            <input type="hidden" name="action" value="record_refund">\\n            {% for field in refund_form %}\\n              {% if field.is_hidden %}{{ field }}{% else %}\\n                <div class="col-6 col-md-3">{{ field.label_tag }}{{ field }}{{ field.errors }}</div>\\n              {% endif %}\\n            {% endfor %}\\n            <div class="col-12 col-md-auto"><button type="submit" class="staff-btn staff-btn--primary staff-btn--touch">Refund</button></div>\\n          </form>\\n        </div>\\n      {% endif %}\\n\\n      {% block order_extra %}{% endblock %}\\n    </aside>\\n  </div>\\n{% endblock %}\\n{% block extra_js %}\\n  {{ block.super }}\\n  {% if is_supermarket_outlet %}<script defer src="{% static \\'staff/retail-counter-v2.js\\' %}?v=20261023.15"></script>{% endif %}\\n  {% if add_line_form %}\\n    {{ pos_menu_item_modifiers|json_script:"staff-pos-menu-modifiers" }}\\n    <script>\\n      (function () {\\n        var dataEl = document.getElementById("staff-pos-menu-modifiers");\\n        var sel = document.getElementById("staff-pos-add-line-menu-item");\\n        var host = document.getElementById("staff-pos-add-line-modifiers");\\n        if (!dataEl || !sel || !host) return;\\n        var map = {};\\n        try {\\n          map = JSON.parse(dataEl.textContent) || {};\\n        } catch (e) {\\n          return;\\n        }\\n        function render() {\\n          host.innerHTML = "";\\n          var id = sel.value || "";\\n          var groups = map[id] || [];\\n          if (!groups.length) return;\\n          for (var gi = 0; gi < groups.length; gi++) {\\n            var g = groups[gi];\\n            var wrap = document.createElement("div");\\n            wrap.className = "mb-2";\\n            var cap = document.createElement("div");\\n            cap.className = "staff-label small mb-1";\\n            var hint = g.name;\\n            if (g.min > 0) {\\n              hint += " (choose at least " + g.min + ")";\\n            }\\n            if (g.max != null) {\\n              hint += " \xb7 max " + g.max;\\n            }\\n            cap.textContent = hint;\\n            wrap.appendChild(cap);\\n            var opts = g.options || [];\\n            for (var oi = 0; oi < opts.length; oi++) {\\n              var o = opts[oi];\\n              var lab = document.createElement("label");\\n              lab.className = "staff-muted d-block small mb-1";\\n              var inp = document.createElement("input");\\n              inp.type = "checkbox";\\n              inp.name = "modifier_option";\\n              inp.value = o.id;\\n              inp.className = "me-1";\\n              lab.appendChild(inp);\\n              var extra = o.name;\\n              if (o.price_delta && o.price_delta !== "0.00") {\\n                extra += " (+" + o.price_delta + ")";\\n              }\\n              lab.appendChild(document.createTextNode(extra));\\n              wrap.appendChild(lab);\\n            }\\n            host.appendChild(wrap);\\n          }\\n        }\\n        sel.addEventListener("change", render);\\n        render();\\n      })();\\n    </script>\\n    <script>\\n      (function () {\\n        var browser = document.querySelector("[data-pos-menu-browser]");\\n        var select = document.getElementById("staff-pos-add-line-menu-item");\\n        if (!browser || !select) return;\\n        var search = browser.querySelector("[data-pos-menu-search]");\\n        var tiles = Array.prototype.slice.call(browser.querySelectorAll("[data-pos-menu-tile]"));\\n        var filters = Array.prototype.slice.call(browser.querySelectorAll("[data-pos-menu-filter]"));\\n        var empty = browser.querySelector("[data-pos-menu-empty]");\\n        var announcement = browser.querySelector("[data-pos-menu-selection]");\\n        var activeCategory = "all";\\n        var quickPicks = browser.querySelector("[data-fizo-favourites]");\\n        if (quickPicks) {\\n          var ranked = tiles.filter(function (tile) { return tile.dataset.fizoQuickPick === "1"; });\\n          if (ranked.length) {\\n            quickPicks.textContent = "";\\n            ranked.forEach(function (tile) {\\n              var shortcut = document.createElement("button");\\n              shortcut.type = "button";\\n              shortcut.className = "fizo-pos-quick-pick";\\n              shortcut.textContent = tile.querySelector(".staff-pos-menu-tile__name").textContent;\\n              shortcut.addEventListener("click", function () {\\n                activeCategory = "all";\\n                filters.forEach(function (filter) {\\n                  var active = filter.dataset.posMenuFilter === "all";\\n                  filter.classList.toggle("is-active", active);\\n                  filter.setAttribute("aria-pressed", active ? "true" : "false");\\n                });\\n                if (search) search.value = "";\\n                updateTiles();\\n                tile.click();\\n              });\\n              quickPicks.appendChild(shortcut);\\n            });\\n          }\\n        }\\n\\n        var pageSize = browser.querySelector("[data-fizo-page-controls]") ? 40 : Infinity;\\n        var pageLimit = pageSize;\\n        var moreControls = browser.querySelector("[data-fizo-page-controls]");\\n        var moreButton = browser.querySelector("[data-fizo-load-more]");\\n        var visibleLabel = browser.querySelector("[data-fizo-visible-count]");\\n        function updateTiles() {\\n          var query = (search && search.value || "").trim().toLowerCase();\\n          var found = 0, visibleCount = 0;\\n          tiles.forEach(function (tile) {\\n            var matchesCategory = activeCategory === "all" || tile.dataset.categoryId === activeCategory;\\n            var matchesSearch = !query || [tile.dataset.itemName, tile.dataset.itemSku, tile.dataset.itemBarcode].some(function (value) { return (value || "").indexOf(query) !== -1; });\\n            var match = matchesCategory && matchesSearch;\\n            if (match) found += 1;\\n            var shown = match && visibleCount < pageLimit;\\n            tile.hidden = !shown;\\n            if (shown) visibleCount += 1;\\n          });\\n          if (empty) empty.hidden = found !== 0;\\n          if (moreControls) {\\n            moreControls.hidden = found <= pageSize;\\n            if (visibleLabel) visibleLabel.textContent = "Showing " + visibleCount + " of " + found + " matching products";\\n            if (moreButton) moreButton.hidden = visibleCount >= found;\\n          }\\n        }\\n        if (moreButton) moreButton.addEventListener("click", function () {\\n          pageLimit += pageSize;\\n          updateTiles();\\n        });\\n\\n        filters.forEach(function (filter) {\\n          filter.addEventListener("click", function () {\\n            activeCategory = filter.dataset.posMenuFilter || "all";\\n            pageLimit = pageSize;\\n            filters.forEach(function (other) {\\n              var active = other === filter;\\n              other.classList.toggle("is-active", active);\\n              other.setAttribute("aria-pressed", active ? "true" : "false");\\n            });\\n            updateTiles();\\n          });\\n        });\\n        if (search) search.addEventListener("input", function () { pageLimit = pageSize; updateTiles(); });\\n        var clearSearch = browser.querySelector("[data-fizo-search-clear]");\\n        if (clearSearch && search) clearSearch.addEventListener("click", function () {\\n          search.value = "";\\n          search.focus();\\n          updateTiles();\\n        });\\n\\n        tiles.forEach(function (tile) {\\n          tile.addEventListener("click", function () {\\n            var itemId = tile.dataset.itemId || "";\\n            select.value = itemId;\\n            select.dispatchEvent(new Event("change", { bubbles: true }));\\n            tiles.forEach(function (other) {\\n              var active = other === tile;\\n              other.classList.toggle("is-selected", active);\\n              other.setAttribute("aria-pressed", active ? "true" : "false");\\n            });\\n            var option = select.options[select.selectedIndex];\\n            if (announcement && option) announcement.textContent = option.text + " selected. Set quantity and add it to the order.";\\n          });\\n        });\\n        select.addEventListener("change", function () {\\n          var selected = tiles.find(function (tile) { return tile.dataset.itemId === select.value; });\\n          tiles.forEach(function (tile) {\\n            var active = tile === selected;\\n            tile.classList.toggle("is-selected", active);\\n            tile.setAttribute("aria-pressed", active ? "true" : "false");\\n          });\\n        });\\n        updateTiles();\\n      })();\\n    </script>\\n  {% endif %}\\n{% endblock %}\\n'
