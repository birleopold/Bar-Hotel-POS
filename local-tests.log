t an item</option>\n            {% for line in order.lines.all %}{% if not line.is_voided %}<option value="{{ line.id }}">{{ line.label }} � {{ line.quantity }}</option>{% endif %}{% endfor %}\n          </select>\n        </div>\n        <div class="col-md-3">{{ line_discount_form.discount_amount.label_tag }}{{ line_discount_form.discount_amount }}</div>\n        <div class="col-md-3">{{ line_discount_form.discount_percent.label_tag }}{{ line_discount_form.discount_percent }}</div>\n        <div class="col-md-3"><button type="submit" class="staff-btn staff-btn--ghost">Apply</button></div>\n      </form>\n    </div>\n  {% endif %}\n  {% if retail_refund_form %}\n    <div class="staff-card">\n      <h2 class="staff-card__title">Return and refund</h2>\n      <p class="staff-muted small">Refund till: {% if settlement_station %}<strong>{{ settlement_station.name }}</strong>{% else %}automatic when one shift is open{% endif %} � <a href="{% url \'staff-workstations\' %}">Choose till</a></p>\n      <p class="staff-muted">Record the returned quantity and the customer refund together. Enter the actual amount to return, including any discount or tax adjustment. Choose the original payment when the order has split tenders. Restock only goods physically received and suitable for resale.</p>\n      <form method="post" class="row g-3 align-items-end">\n        {% csrf_token %}\n        <input type="hidden" name="action" value="retail_line_refund">\n        {% for field in retail_refund_form %}\n          <div class="col-6 col-lg-3">{{ field.label_tag }}{{ field }}{{ field.errors }}</div>\n        {% endfor %}\n        <div class="col-12"><button type="submit" class="staff-btn staff-btn--primary staff-btn--touch">Record return and refund</button></div>\n      </form>\n    </div>\n  {% endif %}\n  {% if line_return_form %}\n    <div class="staff-card">\n      <h2 class="staff-card__title">Physical return only</h2>\n      {% include "staff/includes/form_errors_block.html" with form