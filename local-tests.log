ions</summary>\n                  <form method="post" action="/console/org/setup/step-state/"><input type="hidden" name="csrfmiddlewaretoken" value="HtDTG8t0TNmwToCgbFsXalUGxlarCx9nUU6wTr5QIs7tGGOYxyoz5iTunLUxlHf4">\n                    <input type="hidden" name="step_key" value="device_test"><input type="hidden" name="next" value="/console/org/setup/">\n                    <button type="submit" name="state" value="skipped">Skip for now</button>\n                    \n                  </form>\n                </details>\n              </article>\n            \n              <article class="staff-card fizo-optional__card">\n                <div class="fizo-optional__head">\n                  <span class="fizo-optional__icon" aria-hidden="true"><i class="bi bi-check2-square"></i></span>\n                  <span class="grocery-setup__status">Optional</span>\n                </div>\n                <h3>Practice checkout totals safely</h3>\n                <p>Preview a product&#x27;s section price and tax without placing an order, taking money or changing stock.</p>\n                <div class="fizo-optional__actions">\n                  <a class="staff-btn staff-btn--primary" href="/console/org/setup/practice-sale/">Practice checkout <i class="bi bi-arrow-right" aria-hidden="true"></i></a>\n                  \n                </div>\n                <details class="grocery-setup__more">\n                  <summary>Other options</summary>\n                  <form method="post" action="/console/org/setup/step-state/"><input type="hidden" name="csrfmiddlewaretoken" value="HtDTG8t0TNmwToCgbFsXalUGxlarCx9nUU6wTr5QIs7tGGOYxyoz5iTunLUxlHf4">\n                    <input type="hidden" name="step_key" value="practice_sale"><input type="hidden" name="next" value="/console/org/setup/">\n                    <button type="submit" name="state" value="skipped">Skip for now</button>\n                    \n                  </form>\n                </details>\n              </article>\n