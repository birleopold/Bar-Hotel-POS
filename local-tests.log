ame</option>\n\n  <option value="3a18ba8a-f3fd-477e-97ce-3a21dad5406b">owner-terminal@test.local</option>\n\n  <option value="253dac81-668f-42bf-b7db-b0712c356e2b">worker-terminal@test.local</option>\n\n</select></div>\n<div class="fizo-auth__field"><label for="id_pin">Your PIN</label><input type="password" name="pin" class="staff-input" inputmode="numeric" autocomplete="off" minlength="6" maxlength="8" autofocus required id="id_pin"></div>\n<div class="fizo-auth__keypad" aria-label="On-screen PIN keypad" data-fizo-pin-pad>\n<button class="fizo-auth__key" type="button" data-key="1" aria-label="Digit 1">1</button><button class="fizo-auth__key" type="button" data-key="2" aria-label="Digit 2">2</button><button class="fizo-auth__key" type="button" data-key="3" aria-label="Digit 3">3</button><button class="fizo-auth__key" type="button" data-key="4" aria-label="Digit 4">4</button><button class="fizo-auth__key" type="button" data-key="5" aria-label="Digit 5">5</button><button class="fizo-auth__key" type="button" data-key="6" aria-label="Digit 6">6</button><button class="fizo-auth__key" type="button" data-key="7" aria-label="Digit 7">7</button><button class="fizo-auth__key" type="button" data-key="8" aria-label="Digit 8">8</button><button class="fizo-auth__key" type="button" data-key="9" aria-label="Digit 9">9</button>\n<button class="fizo-auth__key" type="button" data-key="clear">Clear</button>\n<button class="fizo-auth__key" type="button" data-key="0" aria-label="Digit 0">0</button>\n<button class="fizo-auth__key" type="button" data-key="delete">Delete</button>\n</div>\n<button class="fizo-auth__submit" type="submit">Unlock workspace</button>\n<p class="fizo-auth__hint">You can also type your PIN using a keyboard.</p>\n</form>\n\n<p class="fizo-auth__footer">Finished serving? Lock your terminal before handing it to another worker.</p>\n</div>\n</section>\n</main>\n<script>\n(function () {\n  "use strict";\n  var pad=document.querySelector("[data-fizo-pin-pad]");\n  var pi