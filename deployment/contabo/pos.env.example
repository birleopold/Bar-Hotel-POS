# Copy into /etc/leosoft-pos/pos.env (0600, owned by POS service administrator).
# Dedicated Django instance on shared Ubuntu 24.04 Contabo VPS.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=REPLACE_WITH_RANDOM_LONG_SECRET
DATABASE_URL=postgresql://leosoft_pos_app:REPLACE_PASSWORD@127.0.0.1:5432/leosoft_pos
ALLOWED_HOSTS=pos.leosoftug.com
TENANT_PLATFORM_DOMAIN=pos.leosoftug.com
TENANT_DOMAIN_TARGET=pos.leosoftug.com
TENANT_CENTRAL_HOSTS=pos.leosoftug.com
CSRF_TRUSTED_ORIGINS=https://pos.leosoftug.com,https://*.pos.leosoftug.com
USE_X_FORWARDED_PROTO=true
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
# Each custom business domain needs DNS TXT verification, HTTPS provisioning,
# and ALLOWED_HOSTS (or an explicitly reviewed validated suffix).
# Do not use a PostgreSQL superuser, schema/table owner or BYPASSRLS role.
POSTGRES_SET_REQUEST_TENANT_GUC=true
DEFAULT_FROM_EMAIL=POS Notifications <noreply@pos.leosoftug.com>
