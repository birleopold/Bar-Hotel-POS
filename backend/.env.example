SECRET_KEY=change-me
DEBUG=True
# Omit DATABASE_URL to use SQLite at backend/db.sqlite3 (see config/settings/base.py).
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/hospitality_saas
# After tenants.0003_postgres_row_level_security on Postgres, optional defense-in-depth:
# POSTGRES_SET_REQUEST_TENANT_GUC=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Email (production: set real backend, e.g. SMTP). Dev uses console backend in development.py.
DEFAULT_FROM_EMAIL=webmaster@localhost
PASSWORD_RESET_EMAIL_SUBJECT=Password reset
# Staff reset page (same server): http://127.0.0.1:8000/password-reset/confirm/?uid={uid}&token={token}
# Optional production app URL: https://app.example.com/reset-password?uid={uid}&token={token}
# PASSWORD_RESET_URL_TEMPLATE=
# Optional Uganda EFRIS queue (default off).
# EFRIS_INTEGRATION_ENABLED=false
# EFRIS_QUEUE_BATCH_SIZE=50
# EFRIS_RETRY_BASE_SECONDS=300
# Tenant-specific EFRIS credentials live in IntegrationLink settings for provider_key "ura_efris".
# Example keys:
# submit_endpoint, auth_endpoint, tin, branch_id, device_no, access_token,
# client_id, client_secret, api_key, api_secret, signing_mode, encryption_mode.
